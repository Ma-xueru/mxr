<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.CourseDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.CourseEntity" id="courseMap">
        <result property="courseno" column="courseno"/>
        <result property="coursetitle" column="coursetitle"/>
        <result property="coursetype" column="coursetype"/>
        <result property="grade" column="grade"/>
        <result property="picture" column="picture"/>
        <result property="intro" column="intro"/>
        <result property="content" column="content"/>
        <result property="video" column="video"/>
        <result property="thumbsupnum" column="thumbsupnum"/>
        <result property="crazilynum" column="crazilynum"/>
        <result property="clicknum" column="clicknum"/>
        <result property="clicktime" column="clicktime"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.CourseView" >

		SELECT  course.* FROM course  course
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.CourseView" >
		SELECT * FROM course  course <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.CourseView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
