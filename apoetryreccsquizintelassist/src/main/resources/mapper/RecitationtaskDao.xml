<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.RecitationtaskDao">

    <resultMap type="com.cl.entity.RecitationtaskEntity" id="recitationtaskMap">
        <result property="studentaccount" column="studentaccount"/>
        <result property="studentname" column="studentname"/>
        <result property="courseids" column="courseids"/>
        <result property="coursetitles" column="coursetitles"/>
        <result property="tasktitle" column="tasktitle"/>
        <result property="taskcontent" column="taskcontent"/>
        <result property="deadline" column="deadline"/>
        <result property="completionstatus" column="completionstatus"/>
        <result property="completionremark" column="completionremark"/>
        <result property="recitationaudio" column="recitationaudio"/>
        <result property="completiontime" column="completiontime"/>
        <result property="kaoshichengji" column="kaoshichengji"/>
        <result property="teachercomment" column="teachercomment"/>
        <result property="teacheraccount" column="teacheraccount"/>
        <result property="teachername" column="teachername"/>
        <result property="releasetime" column="releasetime"/>
    </resultMap>

    <select id="selectListView" resultType="com.cl.entity.view.RecitationtaskView">
        SELECT recitationtask.* FROM recitationtask recitationtask
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView" resultType="com.cl.entity.view.RecitationtaskView">
        SELECT * FROM recitationtask recitationtask <where>1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectValue" resultType="map">
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM recitationtask
        <where>1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
        limit 10
    </select>

    <select id="selectTimeStatValue" resultType="map">
        <if test = 'params.timeStatType == "日"'>
            SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM recitationtask
            <where>1=1 ${ew.sqlSegment}</where>
            group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
            SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM recitationtask
            <where>1=1 ${ew.sqlSegment}</where>
            group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
            SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM recitationtask
            <where>1=1 ${ew.sqlSegment}</where>
            group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map">
        SELECT ${params.column}, count(1) total FROM recitationtask
        <where>1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
        limit 10
    </select>

</mapper>
