<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.CoursereserveDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.CoursereserveEntity" id="coursereserveMap">
        <result property="studentaccount" column="studentaccount"/>
        <result property="studentname" column="studentname"/>
        <result property="reservetime" column="reservetime"/>
        <result property="teacheraccount" column="teacheraccount"/>
        <result property="teachername" column="teachername"/>
        <result property="reservestatus" column="reservestatus"/>
        <result property="sfsh" column="sfsh"/>
        <result property="shhf" column="shhf"/>
        <result property="reservecount" column="reservecount"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.CoursereserveView" >

		SELECT  coursereserve.* FROM coursereserve  coursereserve
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.CoursereserveView" >
		SELECT * FROM coursereserve  coursereserve <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.CoursereserveView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
