/**app.wxss**/
@import "/static/iconfig/iconfont.wxss";

/* 全局重置和基础样式 */
view {
  box-sizing: border-box;
}

/* 全局文字样式 */
text {
  color: #333333;
  font-size: 28rpx;
}

/* 全局按钮样式 - 蓝色调主题 */
button {
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%);
  color: #FFFFFF !important;
  border-radius: 999rpx !important;
  font-size: 32rpx !important;
  border: none;
  box-shadow: 0 8rpx 18rpx rgba(88, 184, 111, 0.22);
  transition: all 0.3s ease;
}

button:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(88, 184, 111, 0.28);
}

/* 主容器样式 - 简洁蓝色调 */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
  background-color: #F2FBF1;
}

/* 标题样式 - 蓝色主调 */
.title {
  color: #2F8F5B;
  font-weight: 600;
  font-size: 36rpx;
  text-shadow: 0 2rpx 4rpx rgba(88, 184, 111, 0.12);
}

/* 链接样式 - 蓝色强调 */
a {
  color: #2F8F5B;
  text-decoration: none;
  transition: color 0.3s ease;
}

a:active {
  color: #1E7144;
}



input:focus {
  border-color: #58B86F;
  box-shadow: 0 0 0 4rpx rgba(88, 184, 111, 0.14);
  outline: none;
}

/* 图标样式 - 蓝色点缀 */
.icon {
  color: #56BDE8;
}

/* 列表项样式 - 清爽分隔 */
.list-item {
  border-bottom: 1px solid #EEEEEE;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  transition: background-color 0.2s ease;
}

.list-item:active {
  background-color: #EAF8DF;
}

/* 卡片样式 - 现代设计 */
.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(68, 146, 83, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.card:before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #FFD36A 0%, #58B86F 50%, #56BDE8 100%);
}

/* 分割线样式 - 细微区分 */
.divider {
  height: 1px;
  background-color: #EEEEEE;
  margin: 24rpx 0;
}

/* 页面背景 - 清爽基调 */
.page-bg {
  background-color: #F2FBF1;
}

/* 高亮状态 - 蓝色突出 */
.active {
  color: #2F8F5B;
  font-weight: 500;
}

/* 按钮禁用状态 - 统一灰色调 */
button:disabled {
  background: #CCCCCC !important;
  color: #FFFFFF !important;
  box-shadow: none;
  transform: none;
}

/* 提示文本 - 辅助说明 */
.tip-text {
  color: #999999;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 加载状态 - 蓝色旋转动画 */
.loading {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(88, 184, 111, 0.28);
  border-radius: 50%;
  border-top-color: #58B86F;
  animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 响应式调整 */
@media (max-width: 375px) {
  .card {
    padding: 30rpx;
  }
  
  .title {
    font-size: 34rpx;
  }
}
