.forgot-container {
min-height: 100vh;
width: 100%;
padding: 120rpx 44rpx 100rpx;
background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
height: 100%;
display: flex;
justify-content: center;
align-items: center;
}

.forgot-content {
overflow: hidden;
padding: 60rpx 48rpx;
box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
border-radius: 30rpx;
background: var(--white);
width: 100%;
max-width: 580rpx;
position: relative;
}

/* 添加装饰元素 */
.forgot-content::before {
content: '';
position: absolute;
top: -50rpx;
right: -50rpx;
width: 200rpx;
height: 200rpx;
border-radius: 50%;
background: linear-gradient(135deg, var(--primary-light), transparent);
opacity: 0.4;
}

/* 标题样式 */
.page-title {
font-size: 36rpx;
font-weight: 600;
color: var(--primary-color);
text-align: center;
margin: 0 0 50rpx 0;
padding-bottom: 20rpx;
border-bottom: 2rpx solid var(--border-color);
}

.box {
width: 100%;
margin: 0 0 32rpx 0;
height: auto;
position: relative;
}

/* 输入框容器 */
.input-wrapper {
padding: 0 24rpx;
border-radius: 60rpx;
background: #f8f8f8;
height: 90rpx;
display: flex;
align-items: center;
border: 2rpx solid transparent;
transition: all 0.3s ease;
}

.input-wrapper:focus-within {
border-color: var(--primary-color);
background: var(--white);
box-shadow: 0 0 0 10rpx rgba(74, 144, 226, 0.05);
}

input {
border: none;
padding: 0;
margin: 0;
color: var(--text-color);
border-radius: 60rpx;
background: transparent;
width: 100%;
font-size: 30rpx;
height: 100%;
outline: none;
}

input::placeholder {
color: var(--text-secondary);
}

/* 验证码样式 */
.verify-code-box {
width: 100%;
display: flex;
align-items: center;
gap: 20rpx;
}

.verify-input {
flex: 1;
}

.send-code-btn {
padding: 0 30rpx;
height: 90rpx;
border-radius: 60rpx;
background: rgba(74, 144, 226, 0.1);
color: var(--primary-color);
font-size: 28rpx;
text-align: center;
line-height: 90rpx;
border: 2rpx solid var(--primary-color);
transition: all 0.3s ease;
}

.send-code-btn:active {
background: var(--primary-color);
color: var(--white);
}

.next-btn {
border: none;
padding: 0;
margin: 40rpx 0 0;
color: #fff;
border-radius: 60rpx;
background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
width: 100%;
line-height: 90rpx;
font-size: 34rpx;
height: 90rpx;
font-weight: 600;
box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.3);
transition: all 0.3s ease;
}

.next-btn:active {
transform: scale(0.98);
box-shadow: 0 4rpx 15rpx rgba(74, 144, 226, 0.2);
}

/* 返回登录链接 */
.back-login {
margin-top: 30rpx;
text-align: center;
}

.back-login text {
color: var(--primary-color);
font-size: 28rpx;
}

