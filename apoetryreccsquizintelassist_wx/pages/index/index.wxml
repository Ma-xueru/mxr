<view class="index-container">
    <view class="content">
        <!-- 轮播图区域 -->
        <swiper
            indicator-dots="{{true}}"
            autoplay="{{true}}"
            interval="{{5000}}"
            duration="{{500}}"
            class="swiper"
            circular="{{true}}"
            indicator-color="rgba(255,255,255,0.5)"
            indicator-active-color="#58B86F">
            <swiper-item class="swiper-item" wx:for="{{swiperList}}" wx:if="{{index<=2}}" wx:key="index">
                <image
                    src="{{item.img}}"
                    mode="aspectFill"
                    class="swiper-img"
                    lazy-load="true"
                    binderror="imageErrorHandler">
                </image>
                <!-- <view class="swiper-title">{{item.title}}</view> -->
            </swiper-item>
        </swiper>

        <!-- AI背诵评分 -->
        <view class="recite-hero">
          <view class="recite-card {{isStudent ? 'student' : 'teacher'}}" bindtap="goRecite">
            <view class="recite-badge">AI 背诵评分</view>
            <view class="recite-main">
              <text class="recite-icon">{{isStudent ? '🎙️' : '📋'}}</text>
              <view class="recite-text">
                <text class="recite-title">{{isStudent ? '我的背诵任务' : '背诵任务管理'}}</text>
                <text class="recite-sub">{{isStudent ? '录音背诵，AI智能评分' : '一键发布，AI自动评分反馈'}}</text>
              </view>
            </view>
            <view class="recite-bottom" wx:if="{{isStudent && pendingCount > 0}}">
              <view class="recite-task" wx:for="{{pendingTasks}}" wx:key="id" bindtap="goReciteTask" data-id="{{item.id}}">
                <view class="recite-dot"></view>
                <text class="recite-task-title">{{item.tasktitle}}</text>
                <text class="recite-deadline">{{item.deadline}}</text>
              </view>
            </view>
            <view class="recite-btn-row">
              <text class="recite-count" wx:if="{{isStudent}}">{{pendingCount > 0 ? pendingCount + '个待完成' : '暂无任务'}}</text>
              <text class="recite-count" wx:else>{{taskStats.total}}任务 · {{taskStats.pending}}待完成</text>
              <text class="recite-arrow">→</text>
            </view>
          </view>
        </view>

        <!-- 教师发布的测验 -->
        <view class="recite-hero" wx:if="{{isStudent}}">
          <view class="recite-card student quiz-task-card" bindtap="goTaskQuiz">
            <view class="recite-badge quiz-task-badge">📝 教师测验</view>
            <view class="recite-main">
              <text class="recite-icon">📋</text>
              <view class="recite-text">
                <text class="recite-title">教师发布的测验</text>
                <text class="recite-sub">AI出题，自动评分，多维报告</text>
              </view>
            </view>
            <view class="recite-btn-row">
              <text class="recite-arrow">→</text>
            </view>
          </view>
        </view>

        <!-- AI诗词小诗人 -->
        <view class="recite-hero" wx:if="{{isStudent}}">
          <view class="recite-card student poem-creator-card" bindtap="goPoemCreator">
            <view class="recite-badge poem-creator-badge">🌸 AI 诗词小诗人</view>
            <view class="recite-main">
              <text class="recite-icon">🖌️</text>
              <view class="recite-text">
                <text class="recite-title">AI 诗词小诗人</text>
                <text class="recite-sub">拍景生诗，出口成章</text>
              </view>
            </view>
            <view class="recite-btn-row"><text class="recite-arrow">→</text></view>
          </view>
        </view>

      <!-- 每日一句 -->
      <view class="home-quote" wx:if="{{dailyQuote && isStudent}}">
        <text class="home-quote-mark">"</text>
        <text class="home-quote-text">{{dailyQuote}}</text>
        <text class="home-quote-mark">"</text>
      </view>

      <!-- 本周学习热力 -->
      <view class="home-module" wx:if="{{isStudent}}">
        <view class="home-mod-title">🔥 本周学习热力</view>
        <view class="home-heat-row">
          <view class="home-heat-cell" wx:for="{{weeklyHeat}}" wx:key="label">
            <view class="home-heat-dot {{item.active ? 'on' : 'off'}}"></view>
            <text class="home-heat-day">{{item.label}}</text>
          </view>
        </view>
        <text class="home-mod-sub">已坚持 {{totalDays}} 天</text>
      </view>

      <!-- 7日正确率趋势 -->
      <view class="home-module" wx:if="{{isStudent && trend7.length}}">
        <view class="home-mod-title">📈 近7日学习趋势</view>
        <view class="home-trend-row">
          <view class="home-trend-bar-wrap" wx:for="{{trend7}}" wx:key="date">
            <text class="home-trend-val" wx:if="{{item.count > 0}}">{{item.avgScore}}</text>
            <text class="home-trend-val zero" wx:else>-</text>
            <view class="home-trend-bar" style="height:{{item.avgScore * 0.8}}rpx; background:{{item.avgScore>=80?'#4CAF50':item.avgScore>=60?'#FF9800':'#e0e0e0'}}"></view>
            <text class="home-trend-date">{{item.date}}</text>
          </view>
        </view>
      </view>

      <!-- 各模块最佳成绩 -->
      <view class="home-module" wx:if="{{isStudent}}">
        <view class="home-mod-title">🏆 各模块最佳</view>
        <view class="home-best-row">
          <view class="home-best-card"><text class="home-best-val c-green">{{bestScores.follow || 0}}</text><text class="home-best-lbl">🗣️ 跟读</text></view>
          <view class="home-best-card"><text class="home-best-val c-orange">{{bestScores.quiz || 0}}</text><text class="home-best-lbl">✍️ 测验</text></view>
          <view class="home-best-card"><text class="home-best-val c-purple">{{bestScores.analogy || 0}}</text><text class="home-best-lbl">🔄 举一反三</text></view>
          <view class="home-best-card"><text class="home-best-val c-blue">{{bestScores.review || 0}}</text><text class="home-best-lbl">📚 温故知新</text></view>
        </view>
      </view>

    </view>
    <voice-assistant />
</view>
