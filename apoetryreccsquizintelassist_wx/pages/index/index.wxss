/* 全局样式变量定义 */
page {
  --primary-color: #58B86F; /* 儿童乡村清新主题 */
  --primary-light: #EAF8DF;
  --primary-dark: #2F8F5B;
  --text-primary: #333333;
  --text-secondary: #666666;
  --border-color: #D7ECCD;
  --white: #ffffff;
  --shadow: 0 10rpx 26rpx rgba(88, 184, 111, 0.14);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.index-container {
  min-height: calc(100vh - 44px);
  box-sizing: border-box;
  background: linear-gradient(180deg, #E9F8FF 0%, #F2FBF1 42%, #FFF8DC 100%);
}

.content {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: transparent;
  padding-bottom: 40rpx;
}

/* 轮播图样式 */
.swiper {
  width: calc(100% - 40rpx);
  height: 360rpx;
  margin: 20rpx auto;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.swiper-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.swiper-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: var(--transition);
}

.swiper-item:active .swiper-img {
  transform: scale(1.03);
}

.swiper-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--white);
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 菜单网格样式 */
.grid-box {
  width: calc(100% - 40rpx);
  margin: 20rpx auto;
  display: flex;
  flex-wrap: wrap;
  background-color: rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  padding: 30rpx 10rpx;
  box-shadow: var(--shadow);
}

.grid-box-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 15rpx 0;
  border-radius: 16rpx;
  transition: var(--transition);
}

.menu-item:active {
  background-color: #FFF5CC;
  transform: translateY(2rpx);
}

.grid-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #2F8F5B;
  background: linear-gradient(135deg, #FFF0A8 0%, #DFF6CF 100%);
  border-radius: 50%;
  margin: 0 auto 15rpx;
  box-shadow: 0 6rpx 14rpx rgba(88, 184, 111, 0.18);
  transition: var(--transition);
}

.menu-item:active .grid-icon {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx rgba(88, 184, 111, 0.2);
}

.item-munu {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.5;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 弹出框样式 */
.buttom-popup {
  background-color: var(--white);
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  padding-top: 20rpx;
}

.popup-cancel {
  text-align: right;
  padding: 15rpx 30rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.popup-item {
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-primary);
  border-bottom: 2rpx solid var(--border-color);
  margin: 0 30rpx;
  transition: var(--transition);
}

.popup-item:active {
  background-color: var(--primary-light);
  color: var(--primary-color);
}

/* 新闻资讯样式 */
.news-box {
  width: calc(100% - 40rpx);
  margin: 20rpx auto;
  background-color: var(--white);
  border-radius: 24rpx;
  padding: 20rpx 0 30rpx;
  box-shadow: var(--shadow);
}

.news-title-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 15rpx;
  margin: 0 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.news-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
  display: flex;
  align-items: center;
}

.news-title-text::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FFD36A, #58B86F);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.news-title-more {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  transition: var(--transition);
}

.news-title-more:active {
  color: var(--primary-color);
}

.news-title-more::after {
  content: '→';
  font-size: 24rpx;
  margin-left: 5rpx;
}

.news-list-box {
  padding: 10rpx 30rpx;
}

.news-list-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
  transition: var(--transition);
}

.news-list-item:last-child {
  border-bottom: none;
}

.news-list-item:active {
  background-color: rgba(88, 184, 111, 0.06);
}

.list-item-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  object-fit: cover;
  display: block;
  flex-shrink: 0;
}

.list-item-body {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.list-item-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  height: 78rpx;
}

.list-item-introduction {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 10rpx;
}

.list-item-text {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

/* 古诗词学习推荐样式 */
.course-section {
  width: calc(100% - 40rpx);
  margin: 20rpx auto;
  background-color: var(--white);
  border-radius: 24rpx;
  padding: 20rpx 0 30rpx;
  box-shadow: var(--shadow);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 15rpx;
  margin: 0 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.section-title {
  display: flex;
  align-items: center;
}

.title-icon {
  margin-right: 10rpx;
  color: var(--primary-color);
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.section-more {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  transition: var(--transition);
}

.section-more:active {
  color: var(--primary-color);
}

.section-more::after {
  content: '→';
  font-size: 24rpx;
  margin-left: 5rpx;
}

.course-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.course-item {
  width: calc(50% - 15rpx);
  margin-bottom: 25rpx;
}

.course-card {
  background-color: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: var(--transition);
  border: 2rpx solid var(--border-color);
}

.course-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.course-cover {
  position: relative;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.course-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: var(--transition);
}

.course-card:active .course-image {
  transform: scale(1.05);
}

.course-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  padding: 20rpx 16rpx 12rpx;
}

.course-type {
  font-size: 24rpx;
  color: var(--white);
  font-weight: 500;
}

.course-info {
  padding: 15rpx 16rpx;
}

.course-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
  height: 80rpx;
}

.course-author {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-divider {
  margin: 0 10rpx;
  color: #ddd;
}

.ai-float {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(88, 184, 111, 0.28);
  border: 2rpx solid rgba(255, 211, 106, 0.7);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ai-float:active {
  transform: scale(0.96);
}

.ai-face {
  width: 58rpx;
  height: 42rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #56BDE8 0%, #58B86F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.ai-eye {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ffffff;
}

.ai-text {
  color: var(--primary-color);
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
}
