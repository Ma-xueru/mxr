/* 全局样式变量定义 */
page {
  --primary-color: #58B86F; /* 儿童乡村清新主题 */
  --primary-light: #EAF8DF;
  --primary-dark: #2F8F5B;
  --success-color: #58B86F;
  --error-color: #f5222d;
  --warning-color: #F6A63A;
  --purple-color: #722ed1;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --border-color: #D7ECCD;
  --bg-color: #F2FBF1;
  --card-bg: #ffffff;
  --shadow: 0 10rpx 26rpx rgba(88, 184, 111, 0.12);
  --transition: all 0.3s ease;
}

/* 顶部装饰条 */
.top-decoration {
  height: 10rpx;
  width: 100%;
  background: linear-gradient(90deg, #56BDE8 0%, #FFD36A 48%, #58B86F 100%);
}

/* 底部装饰 */
.bottom-decoration {
  height: 120rpx;
  width: 100%;
}

.content {
  width: 100%;
  padding: 0 0 120rpx;
  position: relative;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 用户信息区域 */
.user-info-box {
  padding: 60rpx 40rpx;
  margin: 0 0 30rpx 0;
  background: linear-gradient(135deg, #56BDE8 0%, #58B86F 58%, #F6A63A 100%);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 30rpx 30rpx;
}

/* 背景装饰元素 */
.user-bg-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
  transform: translate(30%, -30%);
}

.left {
  padding: 0;
  align-items: flex-start;
  flex-direction: column;
  background: none;
  display: flex;
  flex: 1;
  z-index: 1;
}

.left-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease;
}

.left-img:active {
  transform: scale(1.05);
}

.left-desc-box {
  margin: 20rpx 0 0 0;
  flex-direction: column;
  display: flex;
  align-items: flex-start;
}

.username {
  line-height: 60rpx;
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
}

.user-meta {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

/* 用户统计数据 */
.user-stats {
  display: flex;
  margin-top: 15rpx;
  width: 100%;
  justify-content: flex-start;
  gap: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  line-height: 1.2;
}

.right {
  margin: 20rpx 20rpx 0 0;
  align-items: center;
  display: flex;
  width: 72rpx;
  justify-content: center;
  color: white;
  z-index: 1;
}

.icons {
  font-size: 48rpx;
  transition: transform 0.3s ease;
}

.icons:active {
  transform: rotate(90deg);
}

/* 未登录状态 */
.no-login {
  padding: 80rpx 40rpx;
  margin: 0 0 30rpx 0;
  background: linear-gradient(135deg, #56BDE8 0%, #58B86F 58%, #F6A63A 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 30rpx 30rpx;
  min-height: 300rpx;
}

.noLogin-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.noLogin-icon .iconfont {
  font-size: 60rpx;
  color: white;
}

.noLogin-text {
  font-size: 36rpx;
  color: white;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 功能列表容器 */
.list-container {
  padding: 0;
  margin: 0 0 120rpx 0;
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.growth-board {
  margin: 0 20rpx 25rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.section-subtitle {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.medal-grid {
  display: flex;
  gap: 20rpx;
}

.medal-card {
  flex: 1;
  background: linear-gradient(135deg, #fff7e5 0%, #ffffff 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(250, 140, 22, 0.08);
}

.class-card {
  background: linear-gradient(135deg, #E9F8FF 0%, #ffffff 100%);
  box-shadow: 0 12rpx 28rpx rgba(86, 189, 232, 0.12);
}

.medal-icon {
  font-size: 42rpx;
}

.medal-value {
  margin-top: 16rpx;
  font-size: 42rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.medal-label {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.action-grid {
  display: flex;
  gap: 20rpx;
}

.action-card {
  flex: 1;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(88, 184, 111, 0.16);
}

.action-recitation {
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%);
}

.action-pk {
  background: linear-gradient(135deg, #FFD36A 0%, #FF8A72 100%);
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
}

.action-desc {
  margin-top: 12rpx;
  min-height: 72rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}

.action-tag {
  margin-top: 18rpx;
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.study-chart-card,
.review-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow);
}

.weak-note {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.weak-summary {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.chart-box {
  margin-top: 24rpx;
  min-height: 220rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
}

.chart-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chart-column-wrap {
  height: 170rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.chart-count {
  margin-bottom: 8rpx;
  color: var(--primary-dark);
  font-size: 22rpx;
}

.chart-column {
  width: 44rpx;
  min-height: 18rpx;
  border-radius: 999rpx 999rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #FFD36A 0%, #58B86F 100%);
  box-shadow: 0 8rpx 20rpx rgba(88, 184, 111, 0.18);
}

.chart-label {
  margin-top: 12rpx;
  color: var(--text-placeholder);
  font-size: 20rpx;
}

.review-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fa8c16 0%, #f5222d 100%);
}

.review-body {
  flex: 1;
}

.review-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.review-reason {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-review {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

/* 菜单卡片样式 */
.menu-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
  margin: 0 20rpx;
}

/* 列表项基础样式 */
.list-item {
  border: 0;
  padding: 0 30rpx;
  margin: 0;
  align-items: center;
  display: flex;
  transition: all 0.3s ease;
  width: 100%;
  position: relative;
  height: 100rpx;
  box-sizing: border-box;
}

.list-item:active {
  background-color: var(--primary-light);
}

.list-img {
  width: 48rpx;
  font-size: 36rpx;
  color: var(--primary-color);
  display: inline-block;
}

.list-text {
  padding: 0 20rpx 0 20rpx;
  margin: 0;
  color: var(--text-primary);
  display: inline-block;
  width: auto;
  line-height: 48rpx;
  font-size: 30rpx;
  flex: 1;
}

.list-icon {
  color: #ccc;
  width: 32rpx;
  line-height: 32rpx;
  font-size: 28rpx;
  transition: transform 0.3s ease;
}

/* 菜单区域样式 */
.menu-section {
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  padding: 25rpx 0;
}

/* 菜单区域标题 */
.menu-section-title {
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 0 30rpx 15rpx;
  margin: 0 0 10rpx 0;
  border-bottom: 1px solid var(--border-color);
}

/* 菜单列表样式 */
.menu-list {
  padding: 10rpx 0;
}

/* 树形菜单样式 */
.treeList {
  border-bottom: 1px solid var(--border-color);
}

.treeList:last-child {
  border-bottom: none;
}

.title {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  height: 100rpx;
  background: white;
  transition: all 0.3s ease;
}

.title:active {
  background-color: var(--primary-light);
}

.title.c1 {
  position: relative;
}

.txt {
  font-size: 30rpx;
  color: var(--text-primary);
  flex: 1;
  margin-left: 20rpx;
}

.icon-xiajiantou {
  font-size: 24rpx;
  color: var(--text-placeholder);
  transition: transform 0.3s ease;
}

/* 子菜单列表样式 */
.treeList .list {
  background-color: rgba(234, 248, 223, 0.55);
  overflow: hidden;
}

/* 箭头图标样式 */
.list-arrow {
  font-size: 24rpx;
  color: var(--text-placeholder);
  width: 30rpx;
  text-align: center;
}

/* 菜单组样式 */
.menu-group {
  border-bottom: 1px solid var(--border-color);
}

.menu-group:last-child {
  border-bottom: none;
}

/* 父菜单样式 */
.parent-menu {
  border-bottom: 1px dashed var(--border-color);
}

.parent-menu:last-child {
  border-bottom: none;
}

/* 子菜单容器样式 */
.submenu-container {
  background-color: rgba(234, 248, 223, 0.55);
}

/* 子菜单包裹器 */
.submenu-wrapper {
  padding-left: 20rpx;
}

/* 子菜单项样式 */
.submenu-item {
  padding-left: 40rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-bottom: 1px solid rgba(220, 228, 242, 0.5);
}

.submenu-item:last-child {
  border-bottom: none;
}

/* 密码修改弹窗 */
.buttom-popup {
  width: 100%;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  box-sizing: border-box;
}

.popup-content {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.popup-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background-color: var(--bg-color);
}

.popup-close .iconfont {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.popup-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.passwordInput {
  background: var(--bg-color);
  margin: 0;
  padding: 0 20rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 28rpx;
  border-radius: 15rpx;
  border: none;
}

.popup-footer {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.update-btn {
  width: 100%;
  height: 90rpx !important;
  line-height: 90rpx !important;
  font-size: 30rpx !important;
  border-radius: 15rpx !important;
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%) !important;
  color: white !important;
  box-shadow: 0 6rpx 16rpx rgba(88, 184, 111, 0.22) !important;
}

/* 其他样式 */
.second-icon {
  width: 28rpx;
  line-height: 28rpx;
  font-size: 28rpx;
  color: #999999;
}

.second-box {
  width: 100%;
  padding: 0;
  margin: 0 0 24rpx 0;
}

.second-text {
  width: 100%;
  padding: 0 20rpx 0 20rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #999999;
  flex: 1;
}

/* AI 智能评估报告 — 展开式面板 */
.report-panel { background: #fdfbf6; border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); border: 1rpx solid #e8e0d0; }
.report-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; background: linear-gradient(135deg, #1B5E20, #388E3C); }
.report-header-left { display: flex; align-items: center; gap: 14rpx; flex: 1; }
.report-header-icon { font-size: 40rpx; }
.report-header-text { display: flex; flex-direction: column; }
.report-header-title { font-size: 30rpx; font-weight: 700; color: #fff; }
.report-header-desc { font-size: 22rpx; color: rgba(255,255,255,.7); margin-top: 4rpx; }
.report-toggle { font-size: 24rpx; color: rgba(255,255,255,.85); white-space: nowrap; }
.report-body { padding: 20rpx 24rpx; }

/* 子模块 */
.report-sub-module { margin-bottom: 24rpx; }
.sub-module-title { font-size: 26rpx; font-weight: 700; color: #3d3532; margin-bottom: 12rpx; }
.report-empty { text-align: center; padding: 30rpx; color: #999; font-size: 24rpx; }

/* 趋势图表 */
.trend-canvas { width: 100%; height: 360rpx; }
.chart-legend { display: flex; justify-content: center; gap: 40rpx; margin-top: 8rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #888; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-dot.follow { background: #4CAF50; }
.legend-dot.quiz { background: #FF9800; }
.ai-comment { padding: 14rpx 18rpx; background: #fff8e1; border-radius: 12rpx; }
.ai-comment-text { font-size: 24rpx; color: #5d4037; line-height: 1.6; }

/* 历史列表 */
.history-item { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 20rpx; background: #fdfbf6; border-radius: 12rpx; margin-bottom: 8rpx; border: 1rpx solid #ede4d3; }
.hi-type { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.hi-type.follow { background: #e8f5e9; color: #2e7d32; }
.hi-type.quiz { background: #fff3e0; color: #e65100; }
.hi-info { flex: 1; }
.hi-title { font-size: 26rpx; font-weight: 600; color: #3d3532; display: block; }
.hi-time { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.hi-score { font-size: 30rpx; font-weight: 800; min-width: 70rpx; text-align: right; }
.hi-score.s-high { color: #4CAF50; }
.hi-score.s-mid { color: #FF9800; }
.hi-score.s-low { color: #F44336; }
