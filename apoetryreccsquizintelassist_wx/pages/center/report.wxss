.report-page { min-height: 100vh; background: #f5f0e8; padding-bottom: 40rpx; }

/* 加载 */
.report-loading { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.loading-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.loading-text { font-size: 28rpx; color: #8b7d6b; }

/* 概览 */
.overview-row { display: flex; gap: 16rpx; padding: 24rpx 30rpx; }
.overview-card { flex: 1; text-align: center; background: #fffdf7; border-radius: 16rpx; padding: 24rpx 12rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.03); }
.ov-value { font-size: 44rpx; font-weight: 800; color: #3d3532; display: block; }
.ov-value.c-green { color: #4CAF50; }
.ov-value.c-orange { color: #FF9800; }
.ov-value.c-red { color: #F44336; }
.ov-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

/* 模块 */
.report-module { margin: 20rpx 30rpx; padding: 24rpx; background: #fffdf7; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.module-title { font-size: 28rpx; font-weight: 700; color: #3d3532; margin-bottom: 16rpx; }

/* 图表 */
.trend-canvas { width: 100%; height: 360rpx; }
.chart-legend { display: flex; justify-content: center; gap: 40rpx; margin-top: 8rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #888; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-dot.follow { background: #4CAF50; }
.legend-dot.quiz { background: #FF9800; }

/* AI 点评 */
.ai-comment { padding: 16rpx 20rpx; background: #fff8e1; border-radius: 12rpx; }
.ai-comment-text { font-size: 24rpx; color: #5d4037; line-height: 1.8; }

/* 历史 */
.history-item { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 20rpx; background: #fdfbf6; border-radius: 12rpx; margin-bottom: 8rpx; border: 1rpx solid #ede4d3; }
.hi-type { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.hi-type.follow { background: #e8f5e9; color: #2e7d32; }
.hi-type.quiz { background: #fff3e0; color: #e65100; }
.hi-info { flex: 1; }
.hi-title { font-size: 26rpx; font-weight: 600; color: #3d3532; display: block; }
.hi-time { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.hi-score { font-size: 30rpx; font-weight: 800; min-width: 70rpx; text-align: right; }
.hi-score.s-high { color: #4CAF50; }
.hi-score.s-mid { color: #FF9800; }
.hi-score.s-low { color: #F44336; }

/* 空状态 */
.report-empty { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #8b7d6b; margin-bottom: 8rpx; }
.empty-desc { font-size: 24rpx; color: #bbb; }
