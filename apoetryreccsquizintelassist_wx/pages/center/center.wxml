<view class="user-container">
  <view class="top-decoration"></view>

  <view class="content">
    <!-- 用户信息区域 -->
    <view wx:if="{{userInfo.id}}" class="user-info-box">
      <view class="user-bg-decoration"></view>

      <view class="header-row">
        <view class="avatar-wrap" bindtap="onAvatarTap">
          <image class="avatar-img" src="{{userInfo.avatar ? baseURL + userInfo.avatar : '/static/default-avatar.png'}}" mode="aspectFill" />
        </view>
        <view class="header-info">
          <view class="header-name">{{userInfo.studentname || userInfo.teachername || userInfo.studentaccount || userInfo.teacheraccount}}</view>
          <view class="header-meta" wx:if="{{isStudent}}">
            {{userInfo.grade || '未设置年级'}} · {{userInfo.classname || '未设置班级'}}
          </view>
        </view>
        <view class="header-gear" bindtap="toDetail">
          <text class="iconfont icon-shezhi1"></text>
        </view>
      </view>
    </view>

    <view class="growth-board" wx:if="{{userInfo.id && isStudent}}">
      <view class="section-title">成长概览</view>
      <view class="wrongbook-card" bindtap="toWrongBook">
        <view class="wrongbook-left">
          <view class="wrongbook-icon">📝</view>
          <view class="wrongbook-info">
            <view class="wrongbook-title">我的错题本</view>
            <view class="wrongbook-desc">回顾测验错题，针对性巩固薄弱知识点</view>
          </view>
        </view>
        <view class="wrongbook-arrow">→</view>
      </view>

      <view class="action-grid">
        <view class="action-card action-report" bindtap="toReport">
          <view class="action-title">AI 智能评估报告</view>
          <view class="action-desc">跟读+测验综合趋势，成长曲线一目了然</view>
          <view class="action-tag">查看 →</view>
        </view>
        <view class="action-card action-pk" bindtap="toAutonomousHistory">
          <view class="action-title">自主学习历史</view>
          <view class="action-desc">跟读·测验·举一反三·温故知新，全量轨迹</view>
          <view class="action-tag">查看 →</view>
        </view>
      </view>

      <!-- 学习数据中心 -->
      <view class="section-title" style="margin-top:12rpx">学习数据中心</view>

      <view class="data-module">
        <view class="data-mod-title">🏆 各模块最佳</view>
        <view class="data-best-row">
          <view class="data-best-card"><text class="data-best-val c-green">{{bestScores.follow || 0}}</text><text class="data-best-lbl">🗣️ 跟读</text></view>
          <view class="data-best-card"><text class="data-best-val c-orange">{{bestScores.quiz || 0}}</text><text class="data-best-lbl">✍️ 测验</text></view>
          <view class="data-best-card"><text class="data-best-val c-purple">{{bestScores.analogy || 0}}</text><text class="data-best-lbl">🔄 举一反三</text></view>
          <view class="data-best-card"><text class="data-best-val c-blue">{{bestScores.review || 0}}</text><text class="data-best-lbl">📚 温故知新</text></view>
        </view>
      </view>

      <view class="data-module">
        <view class="data-mod-title">🔥 本周学习热力</view>
        <view class="data-heat-row">
          <view class="data-heat-cell" wx:for="{{weeklyHeat}}" wx:key="label">
            <view class="data-heat-dot {{item.active ? 'on' : 'off'}}"></view>
            <text class="data-heat-day">{{item.label}}</text>
          </view>
        </view>
        <text class="data-mod-sub">已坚持 {{totalDays}} 天</text>
      </view>

      <view class="data-module" wx:if="{{trend7.length}}">
        <view class="data-mod-title">📈 近7日学习趋势</view>
        <view class="data-trend-row">
          <view class="data-trend-bar-wrap" wx:for="{{trend7}}" wx:key="date">
            <text class="data-trend-val" wx:if="{{item.count > 0}}">{{item.avgScore}}</text>
            <text class="data-trend-val zero" wx:else>-</text>
            <view class="data-trend-bar" style="height:{{item.avgScore * 0.8}}rpx; background:{{item.avgScore>=80?'#4CAF50':item.avgScore>=60?'#FF9800':'#e0e0e0'}}"></view>
            <text class="data-trend-date">{{item.date}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 未登录状态 -->
    <view wx:else class="no-login" bind:tap="tologin">
      <view class="noLogin-icon">
        <text class="iconfont icon-user"></text>
      </view>
      <view class="noLogin-text">登录/注册</view>
      <view class="login-desc">登录后可同步学习进度和记录</view>
    </view>

    <!-- 头像选择弹窗 -->
    <view class="avatar-picker-overlay" wx:if="{{showAvatarPicker}}" bindtap="closeAvatarPicker">
      <view class="avatar-picker-panel" catchtap="noop">
        <view class="ap-title">选择你的专属头像</view>
        <view class="ap-grid">
          <view class="ap-item {{selectedAvatarIndex === index ? 'ap-selected' : ''}}" wx:for="{{avatarPool}}" wx:key="name" data-idx="{{index}}" catchtap="selectAvatar">
            <view class="ap-circle" style="background:{{item.bg}}">
              <image class="ap-avatar-img" src="{{baseURL + item.src}}" mode="aspectFill" />
            </view>
            <text class="ap-name">{{item.name}}</text>
          </view>
        </view>
        <view class="ap-actions">
          <button class="ap-btn cancel" bindtap="closeAvatarPicker">取消</button>
          <button class="ap-btn confirm" bindtap="confirmAvatar">确认使用</button>
        </view>
      </view>
    </view>

    <voice-assistant />
  </view>
</view>
