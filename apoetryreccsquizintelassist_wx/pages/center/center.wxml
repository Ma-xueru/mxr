<view class="user-container">
  <!-- 顶部装饰条 -->
  <view class="top-decoration"></view>

  <view class="content">
    <!-- 用户信息区域 -->
    <view wx:if="{{userInfo.id}}" class="user-info-box">
      <!-- 背景装饰 -->
      <view class="user-bg-decoration"></view>

      <view class="left" bind:tap="toDetail">
        <image class="left-img" src="{{baseURL+userInfo.avatar || '/static/default-avatar.png'}}" mode="cover" lazy-load="true"></image>

        <view class="left-desc-box">
          <view class="username">
            {{nickname==userInfo.studentaccount ? userInfo.studentaccount : userInfo.teacheraccount}}
          </view>
          <view class="user-meta" wx:if="{{isStudent}}">
            {{userInfo.grade || '未设置年级'}} · {{userInfo.classname || '未设置班级'}}
          </view>

          <!-- 用户额外信息 -->
          <view class="user-stats">
            <view class="stat-item">
              <text class="stat-value">{{studyCount || 0}}</text>
              <text class="stat-label">学习次数</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{correctRate || 0}}%</text>
              <text class="stat-label">正确率</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{wordCount || 0}}</text>
              <text class="stat-label">正确次数</text>
            </view>
          </view>
        </view>
      </view>

      <view class="right">
        <text class="iconfont icon-shezhi1 icons" bind:tap="toDetail"></text>
      </view>
    </view>

    <view class="growth-board" wx:if="{{userInfo.id && isStudent}}">
      <view class="section-title">成长概览</view>
      <!-- 错题本 — 独立全宽卡片 -->
      <view class="wrongbook-card" bindtap="toWrongBook">
        <view class="wrongbook-left">
          <view class="wrongbook-icon">📝</view>
          <view class="wrongbook-info">
            <view class="wrongbook-title">我的错题本</view>
            <view class="wrongbook-desc">回顾测验错题，针对性巩固薄弱知识点</view>
          </view>
        </view>
        <view class="wrongbook-arrow">→</view>
      </view>

      <view class="action-grid">
        <!-- AI 智能评估报告 — 点击跳转独立页面 -->
        <view class="action-card action-report" bindtap="toReport">
          <view class="action-title">AI 智能评估报告</view>
          <view class="action-desc">跟读+测验综合趋势，成长曲线一目了然</view>
          <view class="action-tag">查看 →</view>
        </view>

        <view class="action-card action-pk" bindtap="toClassPk">
          <view class="action-title">班级PK</view>
          <view class="action-desc">和同班同学比拼学习成果，获胜拿勋章</view>
          <view class="action-tag">去挑战</view>
        </view>
      </view>
    </view>

    <!-- 未登录状态 -->
    <view wx:else class="no-login" bind:tap="tologin">
      <view class="noLogin-icon">
        <text class="iconfont icon-user"></text>
      </view>
      <view class="noLogin-text">登录/注册</view>
      <view class="login-desc">登录后可同步学习进度和记录</view>
    </view>

    <!-- 功能列表 -->
    <view class="list-container" wx:if="{{userInfo.id}}">
      <!-- 个人功能 -->
      <view class="menu-card">
        <view class="list-item" bind:tap="uppdatePassword">
          <text class="iconfont icon-lock list-img"></text>
          <view class="list-text">密码修改</view>
          <view class="list-icon">></view>

          <!-- 密码修改弹窗 -->
          <com-popup id="bottomFrame" className="buttom-popup">
            <view class="popup-content">
              <view class="popup-header">
                <view class="popup-title">修改密码</view>
                <view class="popup-close" bind:tap="cancelShow">
                  <view class="iconfont icon-close">x</view>
                </view>
              </view>

              <view class="popup-body">
                <input class="passwordInput" model:value="{{passWorded}}" type="password" placeholder="请输入原密码" />
                <input class="passwordInput" type="password" model:value="{{newPassword}}" placeholder="请输入新密码" />
                <input model:value="{{confirmPassword}}" class="passwordInput" type="password" placeholder="请确认新密码" />
              </view>

              <view class="popup-footer">
                <button bindtap="resetpasswordBtn" class="update-btn">确认修改</button>
              </view>
            </view>
          </com-popup>
        </view>
      </view>

    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="bottom-decoration"></view>

<voice-assistant />
</view>
