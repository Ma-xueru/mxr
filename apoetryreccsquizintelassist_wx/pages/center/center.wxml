<view class="user-container">
  <!-- 顶部装饰条 -->
  <view class="top-decoration"></view>

  <view class="content">
    <!-- 用户信息区域 -->
    <view wx:if="{{userInfo.id}}" class="user-info-box">
      <!-- 背景装饰 -->
      <view class="user-bg-decoration"></view>

      <view class="left" bind:tap="toDetail">
        <image class="left-img" src="{{baseURL+userInfo.avatar || '/static/default-avatar.png'}}" mode="cover" lazy-load="true"></image>

        <view class="left-desc-box">
          <view class="username">
            {{nickname==userInfo.studentaccount ? userInfo.studentaccount : userInfo.teacheraccount}}
          </view>
          <view class="user-meta" wx:if="{{isStudent}}">
            {{userInfo.grade || '未设置年级'}} · {{userInfo.classname || '未设置班级'}}
          </view>

          <!-- 用户额外信息 -->
          <view class="user-stats">
            <view class="stat-item">
              <text class="stat-value">{{studyCount || 0}}</text>
              <text class="stat-label">学习次数</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{correctRate || 0}}%</text>
              <text class="stat-label">正确率</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{wordCount || 0}}</text>
              <text class="stat-label">正确次数</text>
            </view>
          </view>
        </view>
      </view>

      <view class="right">
        <text class="iconfont icon-shezhi1 icons" bind:tap="toDetail"></text>
      </view>
    </view>

    <view class="growth-board" wx:if="{{userInfo.id && isStudent}}">
      <view class="section-title">成长概览</view>
      <view class="medal-grid">
        <view class="medal-card" bindtap="toMedalWall">
          <view class="medal-icon">🏅</view>
          <view class="medal-value">{{ownMedalCount || 0}}</view>
          <view class="medal-label">我的勋章</view>
        </view>
        <view class="medal-card class-card">
          <view class="medal-icon">🏆</view>
          <view class="medal-value">{{classMedalCount || 0}}</view>
          <view class="medal-label">班级勋章总数</view>
        </view>
      </view>

      <view class="action-grid">
        <!-- AI 智能评估报告 — 展开式卡片 -->
        <view class="report-panel">
          <view class="report-header" bindtap="toggleReport">
            <view class="report-header-left">
              <text class="report-header-icon">📊</text>
              <view class="report-header-text">
                <text class="report-header-title">AI 智能评估报告</text>
                <text class="report-header-desc">跟读+测验综合趋势，成长曲线一目了然</text>
              </view>
            </view>
            <text class="report-toggle">{{reportExpanded ? '收起' : '展开'}} {{reportExpanded ? '▲' : '▼'}}</text>
          </view>
          <view class="report-body" wx:if="{{reportExpanded}}">
            <!-- 子模块1: 成长曲线 -->
            <view class="report-sub-module" wx:if="{{chartData.length > 0}}">
              <view class="sub-module-title">📈 学习成长曲线</view>
              <canvas type="2d" id="trendChart" class="trend-canvas"></canvas>
              <view class="chart-legend">
                <view class="legend-item"><view class="legend-dot follow"></view><text>跟读</text></view>
                <view class="legend-item"><view class="legend-dot quiz"></view><text>测验</text></view>
              </view>
            </view>
            <!-- 子模块2: AI 导师建议 -->
            <view class="report-sub-module" wx:if="{{aiComment}}">
              <view class="sub-module-title">🤖 AI 导师建议</view>
              <view class="ai-comment">
                <text class="ai-comment-text">{{aiComment}}</text>
              </view>
            </view>
            <!-- 子模块3: 历史记录 -->
            <view class="report-sub-module" wx:if="{{historyList.length > 0}}">
              <view class="sub-module-title">📋 学习记录</view>
              <view class="history-item" wx:for="{{historyList}}" wx:key="index" bindtap="viewRecordDetail" data-index="{{index}}">
                <view class="hi-type {{item.type}}">{{item.type === 'follow' ? '🎙️ 跟读' : '📝 测验'}}</view>
                <view class="hi-info">
                  <text class="hi-title">{{item.courseTitle}}</text>
                  <text class="hi-time">{{item.timeStr}}</text>
                </view>
                <text class="hi-score {{item.score>=85?'s-high':item.score>=60?'s-mid':'s-low'}}">{{item.score}}分</text>
              </view>
            </view>
            <view class="report-empty" wx:if="{{!chartData.length && !historyList.length}}">
              <text>暂无学习记录，去古诗词页面开始练习吧～</text>
            </view>
          </view>
        </view>

        <view class="action-card action-pk" bindtap="toClassPk">
          <view class="action-title">班级PK</view>
          <view class="action-desc">和同班同学比拼学习成果，获胜拿勋章</view>
          <view class="action-tag">去挑战</view>
        </view>
      </view>
    </view>

    <!-- 未登录状态 -->
    <view wx:else class="no-login" bind:tap="tologin">
      <view class="noLogin-icon">
        <text class="iconfont icon-user"></text>
      </view>
      <view class="noLogin-text">登录/注册</view>
      <view class="login-desc">登录后可同步学习进度和记录</view>
    </view>

    <!-- 功能列表 -->
    <view class="list-container" wx:if="{{userInfo.id}}">
      <!-- 个人功能 -->
      <view class="menu-card">
        <view class="list-item" bind:tap="uppdatePassword">
          <text class="iconfont icon-lock list-img"></text>
          <view class="list-text">密码修改</view>
          <view class="list-icon">></view>

          <!-- 密码修改弹窗 -->
          <com-popup id="bottomFrame" className="buttom-popup">
            <view class="popup-content">
              <view class="popup-header">
                <view class="popup-title">修改密码</view>
                <view class="popup-close" bind:tap="cancelShow">
                  <view class="iconfont icon-close">x</view>
                </view>
              </view>

              <view class="popup-body">
                <input class="passwordInput" model:value="{{passWorded}}" type="password" placeholder="请输入原密码" />
                <input class="passwordInput" type="password" model:value="{{newPassword}}" placeholder="请输入新密码" />
                <input model:value="{{confirmPassword}}" class="passwordInput" type="password" placeholder="请确认新密码" />
              </view>

              <view class="popup-footer">
                <button bindtap="resetpasswordBtn" class="update-btn">确认修改</button>
              </view>
            </view>
          </com-popup>
        </view>
      </view>

      <!-- 功能菜单 - 直接硬编码 -->
      <view class="menu-section">
        <view class="menu-section-title">功能菜单</view>
        <view class="menu-list">
          <!-- 测验管理 -->
          <view class="treeList">
            <view class="title c1" bindtap="toggleMenu" data-index="0">
              <text class="iconfont icon-common18 list-img"></text>
              <text class="txt">测验管理</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[0] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[0]">
              <view class="list-item" bindtap="toExamRecord">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">测验记录</text>
                <view class="list-icon">></view>
              </view>
              <view class="list-item" bindtap="toErrorBook">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">错题本</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

          <!-- 意见反馈管理 -->
          <view class="treeList">
            <view class="title c1" bindtap="toggleMenu" data-index="1">
              <text class="iconfont icon-mail-line list-img"></text>
              <text class="txt">意见反馈管理</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[1] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[1]">
              <view class="list-item" bindtap="toFeedback">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">意见反馈</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

          <!-- 学习社区管理 -->
          <view class="treeList">
            <view class="title c1" bindtap="toggleMenu" data-index="2">
              <text class="iconfont icon-chat--line list-img"></text>
              <text class="txt">学习社区管理</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[2] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[2]">
              <view class="list-item" bindtap="toForum">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">学习社区</text>
                <view class="list-icon">></view>
              </view>
            </view>
            <view class="list" wx:if="menuOpen[2]">
              <view class="list-item" bindtap="toMyforum">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">我的发布</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

          <!-- 收藏管理 -->
          <view class="treeList">
            <view class="title c1" bindtap="toggleMenu" data-index="4">
              <text class="iconfont icon-heart--line list-img"></text>
              <text class="txt">收藏管理</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[4] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[4]">
              <view class="list-item" bindtap="toStoreup">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">我的收藏</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>
          <view class="treeList" wx:if="{{isStudent}}">
            <view class="title c1" bindtap="toggleMenu" data-index="5">
              <text class="iconfont icon-football-line list-img"></text>
              <text class="txt">班级PK</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[5] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[5]">
              <view class="list-item" bindtap="toClassPk">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">同班同学PK</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>
          <view class="treeList" wx:if="{{isStudent}}">
            <view class="title c1" bindtap="toggleMenu" data-index="7">
              <text class="iconfont icon-common18 list-img"></text>
              <text class="txt">背诵任务</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[7] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[7]">
              <view class="list-item" bindtap="toRecitationTask">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">我的背诵任务</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

          <view class="treeList" wx:if="{{isStudent}}">
            <view class="title c1" bindtap="toggleMenu" data-index="8">
              <text class="iconfont icon-common18 list-img"></text>
              <text class="txt">预约记录</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[8] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[8]">
              <view class="list-item" bindtap="toCoursereserve">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">我的预约记录</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

          <view class="treeList" wx:if="{{isStudent}}">
            <view class="title c1" bindtap="toggleMenu" data-index="9">
              <text class="iconfont icon-common18 list-img"></text>
              <text class="txt">我的勋章</text>
              <text class="iconfont icon-xiajiantou" style="transform: rotate({{menuOpen[9] ? '180deg' : '0deg'}});">v</text>
            </view>
            <view class="list" wx:if="menuOpen[9]">
              <view class="list-item" bindtap="toMedalWall">
                <text class="iconfont icon-caret-right list-arrow"></text>
                <text class="list-text">勋章墙</text>
                <view class="list-icon">></view>
              </view>
            </view>
          </view>

        </view>
      </view>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="bottom-decoration"></view>

<voice-assistant />
</view>
