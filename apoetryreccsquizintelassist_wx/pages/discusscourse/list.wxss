/* 评论列表样式 */
.comment-container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx;
}

.comment-list {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}

/* 评论项样式 */
.comment-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 15rpx;
  padding-left: 75rpx;
}

/* 回复样式 */
.comment-reply {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-left: 75rpx;
  margin-bottom: 15rpx;
}

.reply-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 底部操作 */
.comment-footer {
  display: flex;
  justify-content: flex-end;
  padding-left: 75rpx;
}

.delete-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #ff4d4f;
}

.delete-btn .iconfont {
  font-size: 24rpx;
  margin-right: 5rpx;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}