<view class="update-container">
  <!-- 顶部装饰条 -->
  <view class="top-decoration"></view>
  
  <!-- 页面标题 -->
  <view class="page-title">
    <view class="title-text">发表评论</view>
    <view class="title-underline"></view>
  </view>
  
  <view class="content">
    <view class="form-box">
      <view class="item-box">
        <view class="item-label">评论内容</view>
        <textarea 
          model:value="{{content}}" 
          placeholder="分享你的想法..." 
          data-info="{{content}}" 
          maxlength="300" 
          id="content"
          bindinput="contentInput"
        ></textarea>
      </view>
      <!-- 字符计数 -->
      <view class="char-count">{{content.length}}/300</view>
    </view>

    <view class="btn-box">
      <button class="submit-btn" bindtap="submit">提交评论</button>
    </view>
  </view>
</view>
