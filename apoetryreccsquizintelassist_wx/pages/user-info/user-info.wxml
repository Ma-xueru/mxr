<view class="register-container">
  <view class="decorative-element top-left"></view>
  <view class="decorative-element bottom-right"></view>
  <view class="top-decoration"></view>

  <view class="content">
    <view class="page-title">
      <text>{{tableName == 'student' ? '个人信息' : '教师信息'}}</text>
    </view>

    <view class="userInfo-from">
      <!-- 学生 -->
      <block wx:if="{{tableName=='student'}}">
        <view class="item-box"><view class="item-label">用户账号</view><input class="item-input" type="text" disabled="true" model:value="{{studentaccount}}" /></view>
        <view class="item-box"><view class="item-label">用户姓名</view><input class="item-input" type="text" disabled="true" model:value="{{studentname}}" /></view>
        <view class="item-box"><view class="item-label">性别</view><input class="item-input" type="text" disabled="true" value="{{genderList[genderIndex]}}" /></view>
        <view class="item-box"><view class="item-label">手机号码</view><input class="item-input" type="text" disabled="true" model:value="{{telephone}}" /></view>
        <view class="item-box"><view class="item-label">年级</view><input class="item-input" type="text" disabled="true" model:value="{{grade}}" /></view>
        <view class="item-box"><view class="item-label">班级</view><input class="item-input" type="text" disabled="true" model:value="{{classname}}" /></view>
      </block>
      <!-- 教师 -->
      <block wx:if="{{tableName=='teacher'}}">
        <view class="item-box"><view class="item-label">教师账号</view><input class="item-input" type="text" disabled="true" model:value="{{teacheraccount}}" /></view>
        <view class="item-box"><view class="item-label">教师姓名</view><input class="item-input" type="text" disabled="true" model:value="{{teachername}}" /></view>
        <view class="item-box"><view class="item-label">性别</view><input class="item-input" type="text" disabled="true" value="{{genderList[genderIndex]}}" /></view>
        <view class="item-box"><view class="item-label">联系电话</view><input class="item-input" type="text" disabled="true" model:value="{{lianxidianhua}}" /></view>
      </block>

      <!-- 密码修改 -->
      <view class="item-box password-row" bindtap="showPasswordPopup">
        <view class="item-label">密码修改</view>
        <view class="item-value">修改登录密码</view>
        <text class="item-arrow">></text>
      </view>

      <view class="btn-box">
        <button class="quit-btn" bindtap="quitTap">退出登录</button>
      </view>
    </view>
  </view>

  <!-- 密码修改弹窗 -->
  <view class="pwd-overlay" wx:if="{{showPassword}}" bindtap="hidePasswordPopup">
    <view class="pwd-popup" catchtap="">
      <view class="pwd-header">
        <text class="pwd-title">修改密码</text>
        <text class="pwd-close" bindtap="hidePasswordPopup">✕</text>
      </view>
      <view class="pwd-body">
        <input class="pwd-input" type="password" model:value="{{oldPassword}}" placeholder="请输入原密码" />
        <input class="pwd-input" type="password" model:value="{{newPassword}}" placeholder="请输入新密码" />
        <input class="pwd-input" type="password" model:value="{{confirmPassword}}" placeholder="请确认新密码" />
      </view>
      <view class="pwd-footer">
        <button class="pwd-confirm" bindtap="doChangePassword">确认修改</button>
      </view>
    </view>
  </view>
</view>
