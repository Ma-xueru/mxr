<view class="register-container">
  <!-- 装饰元素 -->
  <view class="decorative-element top-left"></view>
  <view class="decorative-element bottom-right"></view>
  
  <!-- 顶部装饰条 -->
  <view class="top-decoration"></view>
  
  <view class="content">
    <!-- 页面标题 -->
    <view class="page-title">
      <text>{{tableName == 'student' ? '学生信息编辑' : '教师信息编辑'}}</text>
    </view>
    
    <view class="userInfo-from">
      <!-- 学生信息字段 -->
      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">用户账号</view>
        <input class="item-input" type="text" disabled="true" placeholder="用户账号" model:value="{{studentaccount}}" />
      </view>
      
      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">用户姓名</view>
        <input class="item-input" type="text" placeholder="用户姓名" model:value="{{studentname}}" />
      </view>
      
      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">头像</view>
        <image class="item-img" bindtap="avatarTap" src="{{tempPathavatar}}" mode="aspectFill"></image>
      </view>
      
      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">性别</view>
        <picker class="down-item-picker" mode="selector" range="{{genderList}}" value="{{genderIndex}}" bindchange="genderChange">
          <view class="down-item-picker-text">{{genderList[genderIndex]}}</view>
        </picker>
      </view>
      
      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">手机号码</view>
        <input class="item-input" type="text" placeholder="手机号码" model:value="{{telephone}}" />
      </view>

      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">年级</view>
        <input class="item-input" type="text" disabled="true" model:value="{{grade}}" />
      </view>

      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">班级</view>
        <input class="item-input" type="text" disabled="true" model:value="{{classname}}" />
      </view>

      <view class="item-box" wx:if="{{tableName=='student'}}">
        <view class="item-label">勋章数量</view>
        <input class="item-input" type="text" disabled="true" model:value="{{medalcount}}" />
      </view>
      
      <!-- 教师信息字段 -->
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">教师账号</view>
        <input class="item-input" type="text" disabled="true" placeholder="教师账号" model:value="{{teacheraccount}}" />
      </view>
      
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">教师姓名</view>
        <input class="item-input" type="text" placeholder="教师姓名" model:value="{{teachername}}" />
      </view>
      
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">照片</view>
        <image class="item-img" bindtap="zhaopianTap" src="{{tempPathzhaopian}}" mode="aspectFill"></image>
      </view>
      
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">性别</view>
        <picker class="down-item-picker" mode="selector" range="{{genderList}}" value="{{genderIndex}}" bindchange="genderChange">
          <view class="down-item-picker-text">{{genderList[genderIndex]}}</view>
        </picker>
      </view>
      
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">联系电话</view>
        <input class="item-input" type="text" placeholder="联系电话" model:value="{{lianxidianhua}}" />
      </view>
      
      <view class="item-box" wx:if="{{tableName=='teacher'}}">
        <view class="item-label">可约人数</view>
        <input class="item-input" type="text" placeholder="可约人数" model:value="{{reservecount}}" />
      </view>
      
      <view class="btn-box">
        <button class="save-btn" bindtap="saveTap">保存</button>
        <button class="quit-btn" bindtap="quitTap">退出登录</button>
      </view>
    </view>
  </view>
</view>
    
