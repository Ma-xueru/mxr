.pc-page { display: flex; flex-direction: column; height: 100vh; background: linear-gradient(180deg, #e8f5e9 0%, #f5f0e8 100%); }

.pc-header { text-align: center; padding: 24rpx 30rpx 12rpx; background: linear-gradient(135deg, #81C784, #4CAF50); color: #fff; }
.pc-title { font-size: 36rpx; font-weight: 800; display: block; }
.pc-subtitle { font-size: 24rpx; color: rgba(255,255,255,.8); margin-top: 4rpx; display: block; }

.pc-chat { flex: 1; padding: 20rpx 24rpx; overflow-y: auto; }
.pc-msg { margin-bottom: 18rpx; display: flex; flex-direction: column; }
.pc-bubble { max-width: 88%; padding: 18rpx 22rpx; border-radius: 18rpx; font-size: 30rpx; line-height: 1.8; word-break: break-all; }
.pc-bubble.ai { align-self: flex-start; background: #fff; color: #3d3532; border-bottom-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.pc-bubble.user { align-self: flex-end; background: linear-gradient(135deg, #81C784, #66BB6A); color: #fff; border-bottom-right-radius: 4rpx; }
.pc-loading-text { color: #999; font-size: 26rpx; }
.pc-poem-text { white-space: pre-wrap; }
.pc-msg-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.pc-tts-btn { margin-top: 12rpx; width: 160rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; background: #e8f5e9; color: #2e7d32; border-radius: 28rpx; border: none; }

.pc-input-bar { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 20rpx; background: #fff; border-top: 1rpx solid #e0e0e0; }
.pc-input-actions { display: flex; gap: 4rpx; }
.pc-action-btn { width: 64rpx; height: 64rpx; line-height: 64rpx; font-size: 28rpx; background: #f5f5f5; border-radius: 50%; border: none; padding: 0; text-align: center; }
.pc-action-btn.recording { background: #fdecea; }
.pc-input { flex: 1; height: 64rpx; padding: 0 16rpx; background: #f5f5f5; border-radius: 32rpx; font-size: 28rpx; }
.pc-send-btn { width: 100rpx; height: 64rpx; line-height: 64rpx; background: linear-gradient(135deg, #81C784, #4CAF50); color: #fff; font-size: 26rpx; font-weight: 700; border-radius: 32rpx; border: none; }
