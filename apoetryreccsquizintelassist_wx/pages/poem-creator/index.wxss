.pc-page { display: flex; flex-direction: column; height: 100vh; background: linear-gradient(180deg, #e8f5e9 0%, #f5f0e8 100%); overflow: hidden; }

.pc-header { text-align: center; padding: 24rpx 30rpx 12rpx; background: linear-gradient(135deg, #81C784, #4CAF50); color: #fff; flex-shrink: 0; }
.pc-title { font-size: 36rpx; font-weight: 800; display: block; }
.pc-subtitle { font-size: 24rpx; color: rgba(255,255,255,.8); margin-top: 4rpx; display: block; }

.pc-chat { flex: 1; height: 0; padding: 20rpx 24rpx; overflow-y: auto; }
.pc-msg { margin-bottom: 18rpx; }
.pc-bubble { display: inline-block; max-width: 88%; padding: 18rpx 22rpx; border-radius: 18rpx; font-size: 30rpx; line-height: 1.8; word-break: break-all; }
.pc-bubble.ai { background: #fff; color: #3d3532; border-bottom-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.pc-bubble.user { background: linear-gradient(135deg, #81C784, #66BB6A); color: #fff; border-bottom-right-radius: 4rpx; text-align: right; }
.pc-loading-text { color: #999; font-size: 26rpx; }
.pc-poem-text { white-space: pre-wrap; }
.pc-msg-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.pc-tts-btn { margin-top: 12rpx; width: 160rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; background: #e8f5e9; color: #2e7d32; border-radius: 28rpx; border: none; }

.pc-input-bar { display: flex; flex-direction: row; align-items: center; gap: 0; padding: 12rpx 16rpx; padding-bottom: calc(12rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 0.5px solid #e8e8e8; flex-shrink: 0; }
.pc-cam-btn { width: 72rpx; height: 72rpx; min-width: 72rpx; padding: 0; margin: 0; background: none; border: none; font-size: 36rpx; line-height: 72rpx; text-align: center; flex-shrink: 0; }
.pc-cam-btn::after { border: none; }
.pc-input { flex: 1; min-width: 0; width: 0; height: 80rpx; padding: 0 24rpx; margin: 0 8rpx; background: #f5f5f5; border-radius: 40rpx; font-size: 32rpx; line-height: 80rpx; box-sizing: border-box; }
.pc-send-btn { width: 72rpx; height: 72rpx; min-width: 72rpx; padding: 0; margin: 0; background: #4CAF50; border: none; font-size: 34rpx; line-height: 72rpx; text-align: center; border-radius: 50%; color: #fff; flex-shrink: 0; }
.pc-send-btn::after { border: none; }
.pc-mic-btn { width: 72rpx; height: 72rpx; min-width: 72rpx; padding: 0; margin: 0; background: none; border: none; font-size: 34rpx; line-height: 72rpx; text-align: center; flex-shrink: 0; }
.pc-mic-btn.recording { color: #e53935; }
.pc-mic-btn::after { border: none; }
