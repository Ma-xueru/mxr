<view class="tc-container">
  <view class="tc-header">
    <text class="tc-title">🤖 我的 AI 名师团</text>
    <text class="tc-subtitle">选择一位老师，开启个性化学习之旅</text>
  </view>

  <view class="tc-list">
    <view class="tc-card {{selectedId === item._id ? 'selected' : ''}}" wx:for="{{teachers}}" wx:key="_id" bindtap="selectTeacher" data-id="{{item._id}}" data-index="{{index}}">
      <view class="tc-card-glow" wx:if="{{selectedId === item._id}}"></view>
      <view class="tc-selected-badge" wx:if="{{selectedId === item._id}}">正在教学</view>
      <image class="tc-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view class="tc-info">
        <text class="tc-name">{{item.name}}</text>
        <text class="tc-personality">{{item.personality}}</text>
        <view class="tc-tags">
          <text class="tc-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
      <view class="tc-select-btn {{selectedId === item._id ? 'active' : ''}}" catchtap="selectTeacher" data-id="{{item._id}}" data-index="{{index}}">
        {{selectedId === item._id ? '✓ 已选中' : '就选他/她教我'}}
      </view>
    </view>
  </view>

  <view class="tc-current" wx:if="{{currentTeacher}}">
    <text>当前教师：{{currentTeacher.name}} · {{currentTeacher.modelKey}}</text>
  </view>
</view>
