.tc-container { min-height: 100vh; background: linear-gradient(180deg, #f5f0e8 0%, #ede4d3 100%); padding-bottom: 60rpx; }
.tc-header { text-align: center; padding: 44rpx 30rpx 24rpx; }
.tc-title { font-size: 40rpx; font-weight: 800; color: #3d3532; display: block; }
.tc-subtitle { font-size: 26rpx; color: #999; margin-top: 8rpx; display: block; }

.tc-list { padding: 0 28rpx; display: flex; flex-direction: column; gap: 18rpx; }

.tc-card { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 18rpx; background: #fffdf7; border-radius: 18rpx; position: relative; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); transition: all .2s; }
.tc-card:active { transform: scale(.99); }
.tc-card.selected { box-shadow: 0 0 22rpx rgba(249,168,37,.22); }

.tc-selected-badge { position: absolute; top: 8rpx; right: 10rpx; padding: 4rpx 12rpx; background: #f9a825; color: #fff; font-size: 18rpx; font-weight: 700; border-radius: 8rpx; z-index: 2; }

.tc-avatar-wrap { width: 96rpx; height: 96rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tc-avatar-emoji { font-size: 48rpx; }

.tc-info { flex: 1; min-width: 0; }
.tc-name { font-size: 32rpx; font-weight: 700; color: #3d3532; display: block; }
.tc-title-sub { font-size: 22rpx; color: #999; display: block; margin-top: 2rpx; }
.tc-tags { display: flex; gap: 6rpx; flex-wrap: wrap; margin-top: 6rpx; }
.tc-tag { padding: 2rpx 10rpx; border-radius: 4rpx; font-size: 18rpx; }
.tc-desc { font-size: 22rpx; color: #8b7d6b; margin-top: 6rpx; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

.tc-actions { display: flex; flex-direction: column; gap: 8rpx; align-items: center; flex-shrink: 0; }
.tc-select-btn { padding: 8rpx 18rpx; background: #8b9d6f; color: #fff; font-size: 22rpx; font-weight: 600; border-radius: 20rpx; white-space: nowrap; }
.tc-select-btn.active { background: #f9a825; }
.tc-detail-btn { font-size: 20rpx; color: #999; padding: 4rpx 0; }

/* 详情弹窗 */
.detail-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 9999; display: flex; align-items: flex-end; }
.detail-popup { width: 100%; max-height: 70vh; background: #fffdf7; border-radius: 32rpx 32rpx 0 0; padding: 28rpx 28rpx 40rpx; display: flex; flex-direction: column; }
.detail-header { display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx; }
.detail-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.detail-avatar text { font-size: 40rpx; }
.detail-name-row { flex: 1; }
.detail-name { font-size: 34rpx; font-weight: 700; color: #3d3532; display: block; }
.detail-title { font-size: 24rpx; color: #999; display: block; }
.detail-close { font-size: 36rpx; color: #999; padding: 0 8rpx; }

.detail-body { flex: 1; max-height: 40vh; }
.detail-block { margin-bottom: 20rpx; }
.detail-label { font-size: 26rpx; font-weight: 700; color: #5b503f; display: block; margin-bottom: 6rpx; }
.detail-text { font-size: 26rpx; color: #6d6050; line-height: 1.8; display: block; }

.detail-footer { margin-top: 16rpx; }
.detail-confirm { width: 100%; height: 84rpx; line-height: 84rpx; color: #fff; font-size: 30rpx; font-weight: 700; border-radius: 42rpx; border: none; }
