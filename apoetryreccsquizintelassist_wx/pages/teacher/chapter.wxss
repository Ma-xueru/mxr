/* pages/teacher/chapter.wxss */
.newsDetail-container{
position: relative;
padding-bottom: 160rpx;
background-color: var(--primary-bg);
min-height: 100vh;
}
.title {
text-align: center;
font-size: 36rpx;
font-weight: 700;
margin: 40rpx 20rpx;
color: var(--primary-color);
padding-bottom: 20rpx;
border-bottom: 2rpx solid var(--border-color);
}

.article-content {
margin: 0 30rpx;
padding: 30rpx;
background-color: #fff;
border-radius: 20rpx;
box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
line-height: 52rpx;
color: var(--text-color);
}

.btn {
position: fixed;
width: 100%;
display: flex;
bottom: 0rpx;
background: #fff;
border-top: 2rpx solid var(--border-color);
padding: 20rpx;
}

.btn button {
flex: 1;
background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
color: #fff;
border: none;
border-radius: 10rpx;
font-size: 32rpx;
height: 80rpx;
line-height: 80rpx;
margin: 0 10rpx;
}