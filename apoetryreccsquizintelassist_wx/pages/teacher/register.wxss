/* pages/register/register.wxss */

.register-container {
min-height
:100vh;
width
:100%;
padding
:120rpx 44rpx 244rpx 44rpx;
background
:linear-gradient(135deg, var(--primary-light), var(--primary-color));
}

.avatar {
width
:160rpx;
margin
:0 0 40rpx 0;
border-radius
:100%;
object-fit
:cover;
display
:none;
height
:80rpx;
}
.content {
padding
:48rpx 48rpx 48rpx 48rpx;
box-shadow
:0px 4rpx 20rpx rgba(0, 0, 0, 0.1);
margin
:0 0 244rpx 0;
border-radius
:20rpx;
background
:var(--white);
display
:block;
width
:100%;
position
:relative;
height
:auto;
}

.upload-text{
border
:2rpx solid var(--primary-border);
padding
:0px 24rpx 0 24rpx;
margin
:0 0 0px 0;
color
:var(--text-primary);
border-radius
:60rpx;
background
:var(--white);
width
:100%;
font-size
:28rpx;
height
:80rpx;
}
.upload-img {
width
:160rpx;
border-radius
:16rpx;
object-fit
:contain;
background
:#fff;
display
:block;
height
:120rpx;
}
.box{
width
:100%;
margin
:0 0 24rpx 0;
height
:auto;
}
input{
width:90%!important;
border
:2rpx solid var(--primary-border);
padding
:0px 24rpx 0 24rpx;
margin
:0 0 0px 0;
color
:var(--text-primary);
border-radius
:60rpx;
background
:#ffffff;
width
:100%;
font-size
:28rpx;
height
:80rpx;
}
.select-date{

border
:2rpx solid var(--primary-border);

padding
:0 20rpx;

margin
:0 0 24rpx 0;

border-radius
:60rpx;

background
:var(--white);


height
:auto;
}
.picker-text{
width
:100%;
line-height
:80rpx;
font-size
:28rpx;
color
:var(--text-primary);
}
.register-btn {
border
:0px solid #dddddd;
padding
:0 0 0 0;
margin
:0 0 24rpx 0;
color
:#fff;
border-radius
:60rpx;
background
:var(--primary-color);
width
:100%;
line-height
:80rpx;
font-size
:32rpx;
height
:80rpx;
}
.radio-box{
padding
:0 20rpx 0 20rpx;
margin
:0 0 20rpx 0;
align-items
:center;
border-radius
:60rpx;
background
:#ffffff;
display
:flex;
width
:100%;
}



.checkbox-box{
width
:100%;
padding
:20rpx 20rpx;
margin
:0 0 20rpx 0;
border-radius
:60rpx;
background
:#ffffff;
}
.checkbox-label{
color
:#666;
padding
:0 0 12rpx 0;
}
.checkbox-group-box{
align-items
:center;
flex-wrap
:wrap;
display
:flex;
}
.code-box{
width
:100%;
margin
:0 0 24rpx 0;
flex-wrap
:wrap;
justify-content
:space-between;
display
:flex;
height
:auto;
}
.send-code-btn {
border
:0px solid #dddddd;
padding
:0 0 0 0;
margin
:0 0 0 0;
color
:#fff;
border-radius
:60rpx;
background
:var(--primary-light);
width
:200rpx;
line-height
:80rpx;
font-size
:28rpx;
height
:80rpx;

}
.code-input{
border
:2rpx solid var(--primary-border);
padding
:0 24rpx 0 24rpx;
margin
:0 0 0 0;
color
:var(--text-primary);
border-radius
:60rpx;
background
:var(--white);
width
:calc(100% - 220rpx);
font-size
:28rpx;
height
:80rpx;
}

.item-box{
width
:100%;
margin
:0 0 24rpx 0;
height
:auto;
}
.item-label{
}

.item-radio-itemBox{
padding
:20rpx;
align-items
:center;
border-radius
:60rpx;
flex-wrap
:wrap;
background
:none;
display
:flex;
width
:auto;
}

.active{
color
:#333;
display
:inline-block;
}


.radio-itemText{
color
:#666;
display
:inline-block;
}




.checkBox-active{
color
:#666;
}
.checkBox-itemText{
color
:#666;
}
.item-checkbox-itemBox{
align-items
:center;
flex-wrap
:wrap;
display
:flex;
}
.item-checkbox-item{
align-items
:center;
margin
:0 20rpx 20rpx 0;
display
:flex;
}
checkbox .wx-checkbox-input {
border
:2rpx solid #eeeeee;
border-color
:#666666;
border-radius
:40rpx;
background
:#ffffff;
}
checkbox .wx-checkbox-input.wx-checkbox-input-checked {
border-color
:var(--primary-color);
color
:#fff;
border-radius
:40rpx;
background
:var(--primary-color);
}