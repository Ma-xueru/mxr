/* 全局样式变量定义 - 皇家蓝为主色调 */
page {
  --primary-color: #4169e1; /* 皇家蓝主色调 */
  --primary-light: #e6eeff; /* 浅蓝 - 用于背景和次要元素 */
  --primary-dark: #3056b3; /* 深蓝 - 用于强调和交互元素 */
  --primary-gradient: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  --text-primary: #2c3e50; /* 主要文本色 */
  --text-secondary: #667580; /* 次要文本色 */
  --text-placeholder: #95a5a6; /* 占位符文本色 */
  --border-color: #c9d5e0; /* 边框颜色 */
  --bg-color: #f5f8ff; /* 页面背景色 */
  --card-bg: #ffffff; /* 卡片背景色 */
  --shadow: 0 8rpx 24rpx rgba(65, 105, 225, 0.1); /* 阴影效果 */
  --shadow-hover: 0 12rpx 32rpx rgba(65, 105, 225, 0.15); /* 悬停阴影效果 */
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); /* 过渡动画 */
  --success-color: #52c41a; /* 成功状态颜色 */
  --danger-color: #ff4d4f; /* 取消/删除颜色 */
}

/* 装饰元素 */
.decorative-element {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  background: var(--primary-gradient);
  opacity: 0.03;
  border-radius: 50%;
  z-index: 0;
}

.top-left {
  top: -150rpx;
  left: -150rpx;
}

.bottom-right {
  bottom: -150rpx;
  right: -150rpx;
}

/* 顶部装饰条 */
.top-decoration {
  height: 10rpx;
  width: 100%;
  background: var(--primary-gradient);
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

/* 页面标题 */
.page-title {
  text-align: center;
  padding: 30rpx 0;
  margin: 20rpx 20rpx 30rpx 20rpx;
  background-color: var(--card-bg);
  box-shadow: var(--shadow);
  border-radius: 16rpx;
}

.page-title text {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 600;
  position: relative;
  padding: 0 30rpx;
}

.page-title text::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.goodsClassify-container {
  width: 100vw;
  min-height: 100vh;
  background-color: var(--bg-color);
  position: relative;
  padding-bottom: 120rpx;
}

.content {
  min-height: 100vh;
  width: 100%;
  padding: 0;
  position: relative;
  height: 100%;
}

/* 搜索区域 */
.search {
  padding: 20rpx;
  align-items: center;
  display: flex;
  width: 100%;
  position: relative;
  justify-content: space-between;
  box-sizing: border-box;
}

.search-inp-box {
  background-color: var(--primary-light);
  margin: 0 10rpx 0 0;
  color: var(--text-primary);
  align-items: center;
  border-radius: 60rpx;
  flex: 1;
  display: flex;
  line-height: 72rpx;
  font-size: 28rpx;
  height: 72rpx;
  padding: 0 20rpx;
  transition: var(--transition);
}

.search-inp-box:focus-within {
  box-shadow: 0 0 0 2rpx var(--primary-color);
}

.search-input {
  background: transparent;
  height: 100%;
  padding-left: 20rpx;
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-placeholder);
}

.searchBtn {
  border: none;
  padding: 0 40rpx;
  margin: 0 0 0 10rpx;
  border-radius: 60rpx;
  color: white;
  background: var(--primary-gradient);
  font-size: 28rpx;
  line-height: 72rpx;
  height: 72rpx;
  transition: var(--transition);
  box-shadow: 0 4rpx 12rpx rgba(65, 105, 225, 0.2);
}

.searchBtn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(65, 105, 225, 0.3);
}

.categoryFlag-box {
  width: 100%;
  flex-wrap: wrap;
  background: transparent;
  justify-content: space-between;
  display: flex;
  height: auto;
}

.list-box {
  min-height: 100vh;
  width: 100%;
  padding: 0;
  position: relative;
  background: transparent;
  height: 100%;
}

/* 列表项样式 */
.goodsList-box {
  padding: 0 20rpx;
  margin: 0;
  align-items: flex-start;
  flex-wrap: wrap;
  display: flex;
  width: 100%;
  justify-content: space-between;
  height: auto;
  box-sizing: border-box;
}

.goods-item {
  box-shadow: var(--shadow);
  margin: 0 0 24rpx 0;
  background-color: var(--card-bg);
  border-radius: 20rpx;
  display: flex;
  width: 100%;
  height: auto;
  transition: var(--transition);
  border-left: 6rpx solid var(--danger-color);
  overflow: hidden;
}

.goods-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

.left-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: rgba(255, 77, 79, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 25rpx 20rpx;
  flex-shrink: 0;
}

.left-icon .iconfont {
  font-size: 36rpx;
  color: var(--danger-color);
}

.goods-info {
  flex: 1;
  padding: 25rpx 0;
}

.goods-title {
  padding: 0 20rpx 15rpx 0;
  margin: 0;
  color: var(--text-primary);
  text-align: left;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* 操作按钮区 */
.operate-box {
  padding: 0 20rpx 5rpx 0;
  margin: 0;
  display: flex;
  width: 100%;
  justify-content: flex-start;
  height: auto;
  gap: 30rpx;
}

.edit-box {
  border: none;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  transition: var(--transition);
  cursor: pointer;
}

.edit-box:hover {
  background-color: rgba(82, 196, 26, 0.05);
}

.edit-icons {
  margin: 0 8rpx 0 0;
  font-size: 28rpx;
  line-height: 1;
  color: var(--success-color);
  display: inline-block;
}

.edit-text {
  font-size: 26rpx;
  line-height: 1;
  color: var(--success-color);
  display: inline-block;
}

.delete-box {
  border: none;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  transition: var(--transition);
  cursor: pointer;
}

.delete-box:hover {
  background-color: rgba(255, 77, 79, 0.05);
}

.del-icons {
  margin: 0 8rpx 0 0;
  font-size: 28rpx;
  line-height: 1;
  color: var(--danger-color);
  display: inline-block;
}

.del-text {
  font-size: 26rpx;
  line-height: 1;
  color: var(--danger-color);
  display: inline-block;
}

/* 新增按钮 */
.add-btn {
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(65, 105, 225, 0.2);
  color: white;
  bottom: 60rpx;
  right: 60rpx;
  outline: none;
  border-radius: 50%;
  background: var(--primary-gradient);
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 40rpx;
  position: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  z-index: 999;
}

.add-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(65, 105, 225, 0.3);
}

/* 无数据状态 */
.nodata {
  text-align: center;
  padding: 150rpx 0;
  color: var(--text-placeholder);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.nodata .iconfont {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  color: var(--primary-light);
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  padding: 50rpx 0;
  width: 100%;
}

.loading .dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 8rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading .dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading .dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 引入图标样式 */
@import "/static/iconfig/iconfont.wxss";
    