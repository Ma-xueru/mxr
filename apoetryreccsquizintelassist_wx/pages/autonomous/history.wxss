.ah-page { min-height: 100vh; background: #f5f0e8; padding-bottom: 40rpx; }

/* 概览 */
.ah-overview { margin: 20rpx 24rpx; padding: 24rpx; background: #fffdf7; border-radius: 20rpx; }
.ah-ov-title { font-size: 30rpx; font-weight: 700; color: #3d3532; margin-bottom: 16rpx; }
.ah-ov-cards { display: flex; gap: 12rpx; }
.ah-ov-card { flex: 1; text-align: center; padding: 16rpx 8rpx; background: #faf7f0; border-radius: 14rpx; }
.ah-ov-card:active { background: #f0ebe0; }
.ah-ov-num { font-size: 36rpx; font-weight: 800; color: #3d3532; display: block; }
.ah-ov-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

/* 标签栏 */
.ah-tabs { display: flex; margin: 0 24rpx 16rpx; gap: 8rpx; }
.ah-tab { flex: 1; text-align: center; padding: 16rpx 4rpx; font-size: 24rpx; background: #fff; border-radius: 12rpx; color: #666; border: 2rpx solid transparent; }
.ah-tab.active { background: #8b9d6f; color: #fff; font-weight: 700; border-color: #6d8056; }
.ah-tab:active { opacity: .8; }

/* 加载 */
.ah-loading { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }

/* 记录列表 */
.ah-list { margin: 0 24rpx; display: flex; flex-direction: column; gap: 12rpx; }
.ah-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx; background: #fffdf7; border-radius: 16rpx; box-shadow: 0 4rpx 12rpx rgba(80,50,20,.04); }
.ah-item:active { background: #f5f0e8; }
.ah-item-left { display: flex; flex-direction: column; }
.ah-item-title { font-size: 30rpx; font-weight: 700; color: #3d3532; }
.ah-item-time { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.ah-item-right { display: flex; align-items: center; gap: 8rpx; }
.ah-item-score { font-size: 36rpx; font-weight: 800; }
.ah-item-arrow { font-size: 28rpx; color: #ccc; }

/* 空状态 */
.ah-empty { text-align: center; padding: 120rpx 0; }
.ah-empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.ah-empty-text { font-size: 28rpx; color: #999; }

/* 详情弹窗 */
.ah-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 9999; display: flex; align-items: flex-end; }
.ah-detail { width: 100%; max-height: 90vh; background: #f5f0e8; border-radius: 32rpx 32rpx 0 0; display: flex; flex-direction: column; }
.ah-detail-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 16rpx; }
.ah-detail-title { font-size: 32rpx; font-weight: 700; color: #3d3532; }
.ah-detail-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.ah-detail-scroll { flex: 1; padding: 0 32rpx 40rpx; }
.ah-detail-score-wrap { text-align: center; padding: 20rpx 0 10rpx; }
.ah-detail-score { font-size: 88rpx; font-weight: 800; color: #3d3532; display: block; }
.ah-detail-time { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }

/* 速览分数 */
.ah-quick-scores { display: flex; gap: 12rpx; justify-content: center; margin: 16rpx 0; }
.ah-qs-item { text-align: center; padding: 12rpx 20rpx; background: #fffdf7; border-radius: 12rpx; border: 1px solid #efe5cd; }
.ah-qs-name { font-size: 22rpx; color: #999; display: block; }
.ah-qs-score { font-size: 32rpx; font-weight: 800; color: #4CAF50; display: block; margin-top: 4rpx; }

/* 雷达图 */
.ah-radar-wrap { margin: 16rpx 0; padding: 20rpx; background: #fffdf7; border-radius: 20rpx; }
.ah-radar-canvas { width: 100%; height: 360rpx; }

/* 维度卡片 */
.ah-dim-cards { display: flex; flex-direction: column; gap: 10rpx; margin-top: 12rpx; }
.ah-dim-card { padding: 16rpx 18rpx; background: #fffdf7; border-radius: 14rpx; border: 1px solid #efe5cd; }
.ah-dim-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.ah-dim-name { font-size: 26rpx; font-weight: 700; color: #3f3424; }
.ah-dim-score { font-size: 28rpx; font-weight: 800; }
.ah-dim-bar { height: 8rpx; background: #eee; border-radius: 4rpx; overflow: hidden; margin-bottom: 6rpx; }
.ah-dim-fill { height: 100%; border-radius: 4rpx; }
.ah-dim-comment { font-size: 22rpx; color: #666; line-height: 1.6; }

/* 建议 */
.ah-sug { margin-top: 12rpx; padding: 18rpx 20rpx; background: linear-gradient(135deg,#f0fbf1,#e8f5e9); border-radius: 14rpx; border: 1px solid #c8e6c9; }
.ah-sug-label { font-size: 26rpx; font-weight: 700; color: #2e7d32; display: block; margin-bottom: 8rpx; }
.ah-sug-text { font-size: 24rpx; color: #33691e; line-height: 1.8; }

/* 总评 */
.ah-overall { margin-top: 12rpx; padding: 16rpx 18rpx; background: #f5f6fa; border-radius: 14rpx; }
.ah-ov-label { font-size: 24rpx; font-weight: 700; color: #5b503f; display: block; margin-bottom: 6rpx; }
.ah-ov-text { font-size: 24rpx; color: #6d6050; line-height: 1.8; }
