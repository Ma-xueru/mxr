.fh-page { display: flex; flex-direction: column; height: 100vh; background: linear-gradient(180deg, #f5f0e8 0%, #ede4d3 100%); }

/* 头部 */
.fh-header { padding: 16rpx 24rpx 12rpx; background: linear-gradient(135deg, #4A148C, #7B1FA2); color: #fff; }
.fh-top-row { display: flex; align-items: center; justify-content: space-between; }
.fh-lives { display: flex; gap: 4rpx; }
.fh-heart { font-size: 32rpx; transition: all .3s; }
.fh-heart.off { opacity: .2; filter: grayscale(1); }
.fh-keyword-badge { padding: 6rpx 22rpx; background: rgba(255,255,255,.2); border-radius: 20rpx; font-size: 28rpx; font-weight: 700; }
.fh-timer { text-align: center; }
.fh-timer-ring { width: 60rpx; height: 60rpx; line-height: 60rpx; border-radius: 50%; border: 3rpx solid rgba(255,255,255,.5); font-size: 24rpx; font-weight: 800; font-family: monospace; display: flex; align-items: center; justify-content: center; }
.fh-timer.urgent .fh-timer-ring { border-color: #ef5350; color: #ef5350; animation: pulse 0.5s ease-in-out infinite; }
@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1); } }
.fh-round-badge { font-size: 22rpx; color: rgba(255,255,255,.7); margin-top: 8rpx; text-align: center; }

/* 对话区 */
.fh-chat { flex: 1; padding: 24rpx 24rpx 0; overflow-y: auto; }
.fh-msg { margin-bottom: 18rpx; display: flex; flex-direction: column; }
.fh-bubble { max-width: 85%; padding: 18rpx 22rpx; border-radius: 18rpx; font-size: 30rpx; line-height: 1.7; word-break: break-all; }
.fh-bubble.user { align-self: flex-end; background: linear-gradient(135deg, #8b9d6f, #6d8056); color: #fff; border-bottom-right-radius: 4rpx; }
.fh-bubble.ai { align-self: flex-start; background: #fff; color: #3d3532; border-bottom-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.fh-bubble-tip { margin-top: 8rpx; padding: 8rpx 14rpx; background: #fdecea; color: #c62828; font-size: 22rpx; border-radius: 8rpx; }
.fh-source { display: block; margin-top: 8rpx; font-size: 22rpx; color: #999; }
.fh-comment { display: block; margin-top: 6rpx; font-size: 22rpx; color: #e65100; }

/* AI 输入动画 */
.fh-ai-typing { display: flex; gap: 8rpx; padding: 10rpx 0; }
.fh-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ccc; animation: bounce 0.6s ease-in-out infinite alternate; }
.fh-dot:nth-child(2) { animation-delay: .15s; }
.fh-dot:nth-child(3) { animation-delay: .3s; }
@keyframes bounce { from { transform: translateY(0); opacity: .4; } to { transform: translateY(-10rpx); opacity: 1; } }

/* 输入区 */
.fh-input-bar { display: flex; gap: 8rpx; padding: 16rpx 16rpx; background: #fff; border-top: 1rpx solid #e8e0d0; }
.fh-input { flex: 1; height: 72rpx; padding: 0 16rpx; background: #f5f0e8; border-radius: 36rpx; font-size: 28rpx; }
.fh-send-btn { width: 76rpx; min-width: 76rpx; height: 68rpx; line-height: 68rpx; background: linear-gradient(135deg, #7B1FA2, #9C27B0); color: #fff; font-size: 24rpx; font-weight: 700; border-radius: 34rpx; border: none; padding: 0; }
.fh-actions { display: flex; gap: 12rpx; padding: 8rpx 24rpx 20rpx; background: #fff; }
.fh-action-btn { flex: 1; height: 64rpx; line-height: 64rpx; font-size: 24rpx; color: #7B1FA2; background: #f3e5f5; border-radius: 32rpx; border: none; }
.fh-action-btn.exit { color: #999; background: #f5f5f5; }

/* 结算弹窗 */
.fh-result-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.75); z-index: 9999; display: flex; align-items: center; justify-content: center; }
.fh-result-modal { width: 560rpx; background: linear-gradient(180deg, #fffdf7 0%, #f5f0e8 100%); border-radius: 32rpx; padding: 50rpx 36rpx 36rpx; text-align: center; box-shadow: 0 20rpx 60rpx rgba(0,0,0,.3); }
.fh-result-icon { font-size: 72rpx; display: block; margin-bottom: 8rpx; animation: popIn .5s ease; }
@keyframes popIn { 0% { transform: scale(0); } 70% { transform: scale(1.2); } 100% { transform: scale(1); } }
.fh-result-title { font-size: 30rpx; font-weight: 700; color: #3d3532; margin-bottom: 20rpx; }
.fh-result-score-wrap { margin-bottom: 24rpx; }
.fh-result-score { font-size: 100rpx; font-weight: 800; color: #4A148C; display: block; line-height: 1; animation: popIn .6s ease; }
.fh-result-score-label { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.fh-result-row { display: flex; justify-content: space-around; margin-bottom: 24rpx; }
.fh-result-stat { text-align: center; }
.fh-stat-val { font-size: 36rpx; font-weight: 800; color: #3d3532; display: block; }
.fh-stat-val.grade { color: #e65100; }
.fh-stat-lbl { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.fh-result-title-badge { display: inline-block; padding: 12rpx 36rpx; border-radius: 30rpx; font-size: 30rpx; font-weight: 800; margin-bottom: 28rpx; }
.fh-result-title-badge.gold { background: linear-gradient(135deg,#FFD54F,#FFB300); color: #5d4037; box-shadow: 0 4rpx 20rpx rgba(255,179,0,.4); }
.fh-result-title-badge.silver { background: linear-gradient(135deg,#E0E0E0,#9E9E9E); color: #3d3532; }
.fh-result-title-badge.bronze { background: linear-gradient(135deg,#FFCC80,#FF9800); color: #fff; }
.fh-result-close-btn { width: 100%; height: 80rpx; line-height: 80rpx; background: linear-gradient(135deg,#4A148C,#7B1FA2); color: #fff; font-size: 28rpx; font-weight: 700; border-radius: 40rpx; border: none; }

.fh-speaker { margin-top: 12rpx; font-size: 32rpx; text-align: right; padding: 4rpx 0; }

.fh-mic { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f0ede5; display: flex; align-items: center; justify-content: center; font-size: 30rpx; flex-shrink: 0; transition: all .2s; }
.fh-mic.recording { background: #e53935; color: #fff; animation: micPulse .6s ease-in-out infinite; }
@keyframes micPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.12); } }
