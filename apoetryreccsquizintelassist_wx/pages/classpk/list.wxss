.pk-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 220rpx;
  background: linear-gradient(180deg, #E9F8FF 0%, #F2FBF1 48%, #FFF8DC 100%);
  box-sizing: border-box;
}

.pk-hero {
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #56BDE8 0%, #58B86F 58%, #FFD36A 100%);
  color: #fff;
  box-shadow: 0 18rpx 36rpx rgba(88, 184, 111, 0.22);
}

.pk-title {
  font-size: 40rpx;
  font-weight: 700;
}

.pk-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255,255,255,0.9);
}

.pk-class {
  margin-top: 20rpx;
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.18);
  font-size: 24rpx;
}

.pk-summary {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.summary-card {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(88, 184, 111, 0.1);
}

.summary-card.warm {
  background: linear-gradient(135deg, #FFF2B6 0%, #FFFFFF 100%);
}

.summary-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2f3640;
}

.summary-label {
  margin-top: 8rpx;
  color: #7f8c8d;
  font-size: 24rpx;
}

.section-card {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(88, 184, 111, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f3640;
  margin-bottom: 18rpx;
}

.quiz-card {
  background:
    radial-gradient(circle at top right, rgba(255, 211, 106, 0.28), transparent 28%),
    linear-gradient(180deg, #FFFDF4 0%, #FFFFFF 100%);
  border: 1rpx solid #F2E3A8;
  box-shadow: 0 16rpx 34rpx rgba(88, 184, 111, 0.12);
}

.quiz-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.quiz-opponent {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quiz-opponent-label {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(88, 184, 111, 0.14);
  color: #2F8F5B;
  font-size: 22rpx;
  font-weight: 700;
}

.quiz-opponent-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #2f3640;
}

.quiz-rule {
  font-size: 22rpx;
  color: #A46814;
  background: rgba(255, 211, 106, 0.28);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.quiz-progress {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 248, 220, 0.92);
}

.quiz-progress-text {
  font-size: 23rpx;
  color: #926524;
}

.quiz-progress-bar {
  margin-top: 12rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(226, 205, 160, 0.4);
  overflow: hidden;
}

.quiz-progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD36A 0%, #58B86F 55%, #56BDE8 100%);
  transition: width 0.25s ease;
}

.quiz-question {
  margin-bottom: 18rpx;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #E4F0D8;
  box-shadow: 0 10rpx 22rpx rgba(88, 184, 111, 0.1);
}

.quiz-question:last-child {
  margin-bottom: 0;
}

.quiz-question-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.quiz-title-wrap {
  flex: 1;
}

.quiz-order {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #FFD36A 0%, #FF8A72 100%);
  box-shadow: 0 10rpx 18rpx rgba(255, 138, 114, 0.2);
}

.quiz-title {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #2f3640;
  font-weight: 600;
}

.quiz-type-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.type-0 {
  color: #2F8F5B;
  background: rgba(88, 184, 111, 0.14);
}

.type-1 {
  color: #A46814;
  background: rgba(255, 211, 106, 0.22);
}

.type-2 {
  color: #D45D4B;
  background: rgba(255, 138, 114, 0.14);
}

.type-3 {
  color: #7a6f5f;
  background: rgba(160, 151, 140, 0.14);
}

.quiz-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 16rpx;
}

.quiz-option {
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #4f5d73;
  background: linear-gradient(180deg, #FFFFFF 0%, #F2FBF1 100%);
  border: 1rpx solid #D7ECCD;
  box-sizing: border-box;
}

.quiz-option.active {
  color: #fff;
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%);
  box-shadow: 0 12rpx 22rpx rgba(88, 184, 111, 0.2);
  border-color: transparent;
}

.quiz-option-code {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #2F8F5B;
  background: rgba(88, 184, 111, 0.14);
  flex-shrink: 0;
}

.quiz-option.active .quiz-option-code {
  color: #2F8F5B;
  background: #fff;
}

.quiz-option-text {
  font-size: 26rpx;
  font-weight: 600;
}

.quiz-analysis {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #FFF8DC;
  border: 1rpx solid #F2E3A8;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7A612E;
}

.quiz-input-wrap {
  margin-top: 16rpx;
}

.quiz-input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F2FBF1 100%);
  border: 1rpx solid #D7ECCD;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2f3640;
}

.quiz-btns {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 30rpx rgba(88, 184, 111, 0.14);
  position: sticky;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 10;
}

.ghost-btn,
.submit-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0;
  overflow: visible;
}

.ghost-btn {
  margin: 0;
  background: linear-gradient(180deg, #ffffff 0%, #F2FBF1 100%);
  color: #52635A !important;
  border: 1rpx solid #D7ECCD;
  box-shadow: 0 10rpx 18rpx rgba(88, 184, 111, 0.08);
}

.submit-btn {
  color: #ffffff !important;
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%) !important;
  box-shadow: 0 14rpx 24rpx rgba(88, 184, 111, 0.24);
}

.ghost-btn::after,
.submit-btn::after {
  border: none;
}

.classmate-item,
.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #D7ECCD;
}

.classmate-item:last-child,
.record-item:last-child {
  border-bottom: none;
}

.classmate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.classmate-info {
  flex: 1;
}

.classmate-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3640;
}

.classmate-meta,
.classmate-medal,
.record-text,
.record-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.pk-btn {
  margin: 0;
  min-width: 170rpx;
  height: 74rpx;
  line-height: 74rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD36A 0%, #FF8A72 100%);
  color: #fff;
  font-size: 26rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-status {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.record-status.win {
  background: rgba(88, 184, 111, 0.14);
  color: #2F8F5B;
}

.record-status.lose {
  background: rgba(255, 211, 106, 0.24);
  color: #A46814;
}

.record-status.draw {
  background: rgba(86, 189, 232, 0.16);
  color: #2D86A8;
}

.empty-tip {
  color: #8c98a8;
  font-size: 24rpx;
  line-height: 1.8;
}

@media (max-width: 520rpx) {
  .quiz-options {
    grid-template-columns: 1fr;
  }
}
