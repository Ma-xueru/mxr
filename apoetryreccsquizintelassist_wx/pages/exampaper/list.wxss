/* 全局样式变量定义 */
page {
  --primary-color: #58B86F; /* 儿童乡村清新主题 */
  --primary-light: #EAF8DF;
  --primary-dark: #3056b3;
  --primary-gradient: linear-gradient(135deg, #58B86F, #56BDE8);
  --text-primary: #333333;
  --text-secondary: #666666;
  --border-color: #dce4f2;
  --white: #ffffff;
  --shadow: 0 10rpx 26rpx rgba(88, 184, 111, 0.14);
  --card-shadow: 0 6rpx 18rpx rgba(88, 184, 111, 0.12);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 顶部装饰条 */
.top-decoration {
  height: 12rpx;
  width: 100%;
  background: var(--primary-gradient);
}

.forumCenter-container {
  width: 100vw;
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-title {
  padding: 30rpx 30rpx 15rpx;
  text-align: center;
}

.title-text {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 600;
  position: relative;
  padding: 0 30rpx;
}

.title-underline {
  width: 80rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
  margin: 15rpx auto 0;
  opacity: 0.7;
}

.title {
  padding: 20rpx 30rpx;
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 500;
  display: flex;
  align-items: center;
}

.title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx;
  margin-right: 15rpx;
}

.content {
  letter-spacing: 2rpx;
  display: flex;
  flex-direction: column;
  margin: 0 20rpx;
  flex: 1;
}

.list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nodata {
  flex-grow: 1;
  background-color: var(--white);
  font-size: 28rpx;
  letter-spacing: 2rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--text-secondary);
  height: 400rpx;
  margin: 40rpx 0;
  border-radius: 20rpx;
  box-shadow: var(--card-shadow);
}

.nodata-icon {
  font-size: 80rpx;
  color: var(--primary-light);
  margin-bottom: 20rpx;
}

.list-item {
  width: 100%;
  display: flex;
  justify-content: space-between;
  background-color: var(--white);
  border-radius: 20rpx;
  box-shadow: var(--card-shadow);
  padding: 30rpx;
  box-sizing: border-box;
  height: auto;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.list-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: var(--primary-gradient);
  opacity: 0;
  transition: var(--transition);
}

.list-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 14rpx rgba(88, 184, 111, 0.16);
}

.list-item:hover::before {
  opacity: 1;
}

/* 装饰元素 */
.list-item::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: var(--primary-light);
  border-radius: 50%;
  z-index: 1;
  opacity: 0.5;
}

/* 优化后的左侧字符容器样式 */
.left {
  margin: 0;
  height: 120rpx;
  width: 120rpx;
  background-color: var(--primary-light);
  display: grid; /* 使用网格布局 */
  grid-template-columns: 1fr 1fr; /* 2列 */
  grid-template-rows: 1fr 1fr; /* 2行 */

  padding: 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 单个字符样式 */
.char-item {
  font-size: 28rpx;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 6rpx;
  width: 100%;
  height: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.right {
  margin: 0 0 0 25rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.right view:first-child {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.right view:nth-child(2) {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.right view:nth-child(2) .icon-clock {
  margin-right: 10rpx;
  color: var(--primary-color);
  font-size: 24rpx;
}

button {
  color: var(--white);
  background-color: var(--primary-color);
  border-color: var(--primary-color);
  font-size: 26rpx;
  border-radius: 60rpx;
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  box-shadow: 0 6rpx 14rpx rgba(88, 184, 111, 0.2);
  transition: var(--transition);
  font-weight: 500;
  width: auto;
  align-self: flex-start;
}

button:active {
  background-color: var(--primary-dark);
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(88, 184, 111, 0.2);
}

@import "/static/iconfig/iconfont.wxss";

.search {
  height: 120rpx;
  background-color: var(--white);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 28rpx;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  background-color: #f5f7fa;
  height: 76rpx;
  color: var(--text-primary);
  width: calc(100% - 160rpx);
  border-radius: 60rpx;
  padding-left: 80rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: var(--transition);
  box-sizing: border-box;
}

.search-input:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(88, 184, 111, 0.14);
}

.icons {
  width: auto;
  position: absolute;
  left: 50rpx;
  line-height: 76rpx;
  font-size: 32rpx;
  color: var(--text-secondary);
}

.searchBtn {
  background-color: var(--primary-color);
  margin: 0 0 0 20rpx;
  height: 76rpx;
  width: 140rpx;
  line-height: 76rpx;
  text-align: center;
  letter-spacing: 2rpx;
  border-radius: 60rpx;
  color: var(--white);
  font-weight: 500;
  transition: var(--transition);
  box-shadow: 0 6rpx 14rpx rgba(88, 184, 111, 0.2);
}

.searchBtn:active {
  background-color: var(--primary-dark);
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(88, 184, 111, 0.2);
}

/* 回到顶部按钮 */
.to-top-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: var(--primary-color);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(88, 184, 111, 0.26);
  z-index: 998;
  transition: var(--transition);
  opacity: 0.8;
}

.to-top-btn:active {
  transform: scale(0.95);
  background-color: var(--primary-dark);
}

.to-top-btn .icon-arrowup {
  font-size: 36rpx;
  line-height: 1;
}

/* 能力雷达图 */
.radar-section { margin: 20rpx 30rpx; padding: 24rpx; background: #fffdf7; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.radar-title { font-size: 28rpx; font-weight: 700; color: #3d3532; margin-bottom: 16rpx; }
.radar-canvas { width: 100%; height: 400rpx; }
.radar-legend { display: flex; justify-content: space-around; margin-top: 12rpx; }
.radar-dim { display: flex; align-items: center; gap: 4rpx; font-size: 20rpx; color: #888; }
.rd-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.rd-0 { background: #e57373; } .rd-1 { background: #64B5F6; } .rd-2 { background: #FFB74D; } .rd-3 { background: #81C784; }
.rd-val { color: #555; font-weight: 600; }

/* 飞花令入口 */
.feihua-card { margin: 16rpx 30rpx; }
.feihua-bg { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 28rpx; background: linear-gradient(135deg, #4A148C, #7B1FA2); border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(74,20,140,.3); }
.feihua-bg:active { transform: scale(.98); }
.feihua-icon { font-size: 48rpx; }
.feihua-text { flex: 1; }
.feihua-title { font-size: 30rpx; font-weight: 700; color: #fff; display: block; }
.feihua-desc { font-size: 22rpx; color: rgba(255,255,255,.7); margin-top: 4rpx; display: block; }
.feihua-arrow { font-size: 36rpx; color: rgba(255,255,255,.8); font-weight: 700; }
.feihua-stats { display: flex; gap: 24rpx; margin-top: 8rpx; }
.feihua-stat { font-size: 20rpx; color: rgba(255,255,255,.75); }

/* 智能角标 */
.item-badge { position: absolute; top: 12rpx; right: 12rpx; z-index: 2; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; background: #fdecea; color: #c62828; font-weight: 600; }
.item-badge.green { background: #e8f5e9; color: #2e7d32; }

/* 进度环 */
.progress-ring { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; }
.ring-bg { flex: 1; height: 8rpx; background: #eee; border-radius: 4rpx; overflow: hidden; }
.ring-fill { height: 100%; background: linear-gradient(90deg,#81C784,#4CAF50); border-radius: 4rpx; }
.ring-text { font-size: 20rpx; color: #4CAF50; font-weight: 600; min-width: 50rpx; }

.item-meta { display: flex; gap: 16rpx; font-size: 22rpx; color: #888; margin-top: 4rpx; }
.item-score { color: #4CAF50; font-weight: 600; }
