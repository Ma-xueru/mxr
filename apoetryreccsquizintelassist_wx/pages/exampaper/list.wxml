<view class="forumCenter-container">
  <view class="top-decoration"></view>

  <view class="page-title">
    <view class="title-text">AI 智适应学习引擎</view>
    <view class="title-underline"></view>
  </view>

  <!-- 能力雷达图 -->
  <view class="radar-section" wx:if="{{ability}}">
    <view class="radar-title">📊 能力雷达</view>
    <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
    <view class="radar-legend">
      <view class="radar-dim" wx:for="{{dimensions}}" wx:key="*this">
        <view class="rd-dot rd-{{index}}"></view>
        <text>{{item}}</text>
        <text class="rd-val">{{ability[item] || 0}}分</text>
      </view>
    </view>
  </view>

  <!-- 飞花令入口 -->
  <view class="feihua-card" bindtap="toFeiHuaLing">
    <view class="feihua-bg">
      <text class="feihua-icon">🌸</text>
      <view class="feihua-text">
        <text class="feihua-title">AI 飞花令 · 实时对战</text>
        <text class="feihua-desc">与 AI 对诗，以字为令，高手过招</text>
        <view class="feihua-stats" wx:if="{{fhlProfile}}">
          <text class="feihua-stat">最高分：{{fhlProfile.maxScore || 0}}</text>
          <text class="feihua-stat">段位：{{fhlProfile.title || '诗词书童'}}</text>
        </view>
      </view>
      <text class="feihua-arrow">→</text>
    </view>
  </view>

  <view class="search">
    <input class="search-input" model:value="{{name}}" type="text" placeholder="搜索测验...">
    <text class="iconfont icon-sousuo4 icons"></text>
    </input>
    <view class="searchBtn" bind:tap="searhandler">搜索</view>
  </view>

  <view class="content">
    <view class="title">智能推荐测验</view>
    <view class="list">
      <view class="list-item" wx:for="{{currentList}}" wx:key="{{index}}">
        <view class="item-badge" wx:if="{{item.weight > 80}}">建议复习</view>
        <view class="item-badge green" wx:elif="{{item.weight < 30 && item.latestScore >= 90}}">已掌握</view>
        <view class="left">
          <view class="iconfont icon-book1 char-item">{{item.name[0] || ''}}</view>
          <view class="iconfont icon-book1 char-item">{{item.name[1] || ''}}</view>
          <view class="iconfont icon-book1 char-item">{{item.name[2] || ''}}</view>
          <view class="iconfont icon-book1 char-item">{{item.name[3] || ''}}</view>
        </view>
        <view class="right">
          <view>{{item.name}}</view>
          <view class="item-meta">
            <text class="iconfont icon-clock"></text>限时:{{item.time}}分钟
            <text class="item-score" wx:if="{{item.latestScore !== undefined}}">最高:{{item.latestScore}}分</text>
          </view>
          <!-- 进度环 -->
          <view class="progress-ring" wx:if="{{item.latestScore !== undefined}}">
            <view class="ring-bg"><view class="ring-fill" style="width:{{item.latestScore}}%"></view></view>
            <text class="ring-text">{{item.latestScore}}%</text>
          </view>
          <view>
            <button bindtap="examTap" data-id="{{item.id}}">开始测验</button>
          </view>
        </view>
      </view>
      <view class="nodata" wx:if="{{currentList.length === 0}}">
        <text class="iconfont icon-book1 nodata-icon"></text>
        <view>~没有找到相关古诗词学习~</view>
      </view>
    </view>
  </view>

  <view class="to-top-btn" bindtap="backToTop">
    <view class="iconfont icon-arrowup">top</view>
  </view>

<voice-assistant />
</view>
