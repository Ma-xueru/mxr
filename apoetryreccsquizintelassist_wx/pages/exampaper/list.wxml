<view class="forumCenter-container">
  <view class="top-decoration"></view>

  <view class="page-title">
    <view class="title-text">AI 智适应学习引擎</view>
    <view class="title-underline"></view>
  </view>

  <!-- 能力雷达图 -->
  <view class="radar-section" wx:if="{{ability}}">
    <view class="radar-title">📊 能力雷达</view>
    <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
    <view class="radar-legend">
      <view class="radar-dim" wx:for="{{dimensions}}" wx:key="*this">
        <view class="rd-dot rd-{{index}}"></view>
        <text>{{item}}</text>
        <text class="rd-val">{{ability[item] || 0}}分</text>
      </view>
    </view>
  </view>

  <!-- 飞花令入口 -->
  <view class="feihua-card" bindtap="toFeiHuaLing">
    <view class="feihua-bg">
      <text class="feihua-icon">🌸</text>
      <view class="feihua-text">
        <text class="feihua-title">AI 飞花令 · 实时对战</text>
        <text class="feihua-desc">与 AI 对诗，以字为令，高手过招</text>
        <view class="feihua-stats" wx:if="{{fhlProfile}}">
          <text class="feihua-stat">最高分：{{fhlProfile.maxScore || 0}}</text>
          <text class="feihua-stat">段位：{{fhlProfile.title || '诗词书童'}}</text>
          <text class="feihua-rank-btn" catchtap="showRankPopup">🏆 班级荣誉榜</text>
        </view>
      </view>
      <text class="feihua-arrow">→</text>
    </view>
  </view>

  <!-- 班级排行弹窗 -->
  <view class="rank-overlay" wx:if="{{showRank}}" bindtap="hideRankPopup">
    <view class="rank-popup" catchtap="">
      <view class="rank-header">
        <text class="rank-title">{{rankClassName}} · 飞花令战力榜</text>
        <text class="rank-close" bindtap="hideRankPopup">✕</text>
      </view>
      <scroll-view class="rank-list" scroll-y wx:if="{{rankList.length}}">
        <view class="rank-item" wx:for="{{rankList}}" wx:key="index">
          <view class="rank-left">
            <view class="rank-num rank-{{index < 3 ? (index === 0 ? 'gold' : index === 1 ? 'silver' : 'bronze') : 'normal'}}">{{index + 1}}</view>
            <text class="rank-name">{{item.username || '佚名'}}</text>
          </view>
          <text class="rank-score">{{item.maxScore || 0}} 分</text>
        </view>
      </scroll-view>
      <view class="rank-empty" wx:else><text>暂无对战记录，去飞花令大战一场吧～</text></view>
    </view>
  </view>

  <!-- AI 智能训练入口 -->
  <view class="ai-train-cards">
    <view class="train-card" bindtap="startHistoryReview">
      <view class="train-card-icon">📖</view>
      <view class="train-card-title">温故而知新</view>
      <view class="train-card-desc">基于近14天学习足迹，AI 实时组卷</view>
      <view class="train-card-btn">开始训练 →</view>
    </view>
    <view class="train-card analogy" bindtap="startAnalogy">
      <view class="train-card-icon">💡</view>
      <view class="train-card-title">举一反三</view>
      <view class="train-card-desc">针对薄弱标签，AI 匹配同类题目</view>
      <view class="train-card-btn">开始训练 →</view>
    </view>
  </view>

  <!-- AI 出题加载蒙层 -->
  <view class="ai-loading-overlay" wx:if="{{aiLoading}}">
    <view class="ai-loading-modal">
      <text class="ai-loading-icon">🤖</text>
      <text class="ai-loading-title">AI 导师正在出题中...</text>
      <text class="ai-loading-hint">{{aiLoadingHint}}</text>
      <view class="ai-loading-bar"><view class="ai-loading-fill"></view></view>
    </view>
  </view>


<voice-assistant />
</view>
