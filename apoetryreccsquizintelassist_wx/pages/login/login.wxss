/* 全局样式 */
page {
  --primary-color: #4169e1; /* 皇家蓝主色调 */
  --primary-light: #e6eeff;
  --primary-dark: #3056b3;
  --text-primary: #333333;
  --text-secondary: #666666;
  --border-color: #dce4f2;
  --white: #ffffff;
  --shadow: 0 8rpx 24rpx rgba(65, 105, 225, 0.15);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 登录容器 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f0f5ff, #e6eeff);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 44rpx;
  box-sizing: border-box;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  max-width: 580rpx;
  background: var(--white);
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

/* 卡片装饰元素 */
.card-decoration {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  background: rgba(65, 105, 225, 0.05);
  border-radius: 50%;
  z-index: 0;
}

.top-left {
  top: -60rpx;
  left: -60rpx;
  animation: float 6s ease-in-out infinite;
}

.top-right {
  top: -40rpx;
  right: -40rpx;
  background: rgba(65, 105, 225, 0.07);
  animation: float 7s ease-in-out 1s infinite;
}

.bottom-left {
  bottom: -50rpx;
  left: -50rpx;
  background: rgba(65, 105, 225, 0.06);
  animation: float 8s ease-in-out 2s infinite;
}

.bottom-right {
  bottom: -70rpx;
  right: -70rpx;
  animation: float 9s ease-in-out 3s infinite;
}

/* 内容区域 */
.content {
  padding: 80rpx 56rpx 60rpx;
  position: relative;
  z-index: 1;
}

/* 应用图标 */
.app-icon {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 40rpx;
  background: var(--primary-light);
  border-radius: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(65, 105, 225, 0.1);
}

.icon-inner {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-color);
  border-radius: 50%;
  position: relative;
}

.icon-inner::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--white);
  top: 20rpx;
  left: 20rpx;
}

/* 应用标题 */
.app-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 60rpx;
  letter-spacing: 2rpx;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

/* 输入项 */
.input-item {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
  border-radius: 60rpx;
  background: var(--white);
  width: 100%;
  height: 96rpx;
  border: 2rpx solid var(--border-color);
  transition: var(--transition);
  box-sizing: border-box;
}

.input-item:focus-within {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 10rpx rgba(65, 105, 225, 0.08);
  transform: translateY(-2rpx);
}

.input-icon {
  color: var(--primary-color);
  margin-right: 20rpx;
  opacity: 0.7;
}

input {
  border: none;
  padding: 0;
  margin: 0;
  color: var(--text-primary);
  background: transparent;
  width: 100%;
  font-size: 30rpx;
  height: 100%;
  outline: none;
}

input::placeholder {
  color: #999999;
  font-size: 28rpx;
}

/* 选择器区域 */
.section {
  padding: 0 30rpx;
  margin: 0 0 40rpx 0;
  border-radius: 60rpx;
  background: var(--white);
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--border-color);
  transition: var(--transition);
  box-sizing: border-box;
}

.section:focus-within {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 10rpx rgba(65, 105, 225, 0.08);
}

.picker-text {
  width: 100%;
  line-height: 96rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
  padding: 0;
  display: flex;
  align-items: center;
}

.picker-icon {
  color: var(--primary-color);
  margin-right: 20rpx;
  opacity: 0.7;
}

/* 登录按钮 */
.login-btn {
  border: none;
  padding: 0;
  margin: 20rpx 0 40rpx;
  color: var(--white);
  border-radius: 60rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  width: 100%;
  height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(65, 105, 225, 0.25);
  transition: var(--transition);
  display: flex;
  justify-content: center;
  align-items: center;
}

.login-btn .btn-text {
  margin-right: 10rpx;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(65, 105, 225, 0.2);
  background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
}

/* 操作行 */
.action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

/* 注册按钮 */
.register-btn {
  padding: 12rpx 36rpx;
  font-size: 28rpx;
  color: var(--primary-color);
  border-radius: 60rpx;
  background: var(--primary-light);
  transition: var(--transition);
}

.register-btn:active {
  background: rgba(65, 105, 225, 0.15);
  transform: translateY(2rpx);
}

/* 服务器切换 */
.server-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 0;
  gap: 12rpx;
  opacity: 0.8;
}
.server-label {
  font-size: 24rpx;
  color: #999;
}
.server-text {
  font-size: 24rpx;
  color: #666;
}

/* 浮动动画 */
@keyframes float {
  0% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-20rpx) rotate(5deg);
  }
  100% {
    transform: translateY(0) rotate(0deg);
  }
}
