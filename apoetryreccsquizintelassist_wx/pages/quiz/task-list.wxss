.tl-page { min-height: 100vh; background: #f5f0e8; padding: 24rpx 30rpx; }
.tl-empty { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.tl-empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.tl-empty-text { font-size: 28rpx; color: #999; }
.tl-card { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; background: #fffdf7; border-radius: 20rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.tl-card:active { transform: scale(.98); }
.tl-card-icon { font-size: 44rpx; }
.tl-card-info { flex: 1; }
.tl-card-title { font-size: 30rpx; font-weight: 700; color: #3d3532; display: block; }
.tl-card-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.tl-card-arrow { font-size: 32rpx; color: #ccc; }
