.tl-page { min-height: 100vh; background: #f5f0e8; padding: 24rpx 30rpx; }
.tl-empty { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.tl-empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.tl-empty-text { font-size: 28rpx; color: #999; }

/* 卡片 */
.tl-card { background: #fff; border-radius: 32rpx; padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,.06); position: relative; overflow: hidden; }
.tl-card:active { transform: scale(.98); }
.tl-card.done::before { content: ''; position: absolute; top: 0; left: 0; width: 6rpx; height: 100%; background: #4CAF50; border-radius: 3rpx 0 0 3rpx; }
.tl-card.pending::before { content: ''; position: absolute; top: 0; left: 0; width: 6rpx; height: 100%; background: #FF9800; border-radius: 3rpx 0 0 3rpx; }

/* 顶部行 */
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }

.card-badge { font-size: 22rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx; }
.card-badge.quiz { background: #F3E5F5; color: #7B1FA2; }
.card-badge.recite { background: #E8F5E9; color: #2E7D32; }

.card-status { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; font-weight: 600; }
.card-status.done { color: #4CAF50; }
.card-status.pending { color: #FF9800; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.card-status.done .status-dot { background: #4CAF50; }
.card-status.pending .status-dot { background: #FF9800; }

/* 标题 */
.card-poem { font-size: 36rpx; font-weight: 800; color: #1a1a1a; margin-bottom: 8rpx; line-height: 1.3; }
.card-info { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }

/* 元信息 */
.card-meta { display: flex; gap: 10rpx; margin-bottom: 24rpx; }
.card-meta-item { flex: 1; text-align: center; padding: 16rpx 8rpx; background: #faf7f0; border-radius: 16rpx; }
.meta-label { font-size: 22rpx; color: #bbb; display: block; margin-bottom: 6rpx; }
.meta-value { font-size: 26rpx; font-weight: 600; color: #555; display: block; }
.meta-value.score.high { color: #4CAF50; font-size: 32rpx; font-weight: 800; }
.meta-value.score.mid { color: #FF9800; }
.meta-value.score.none { color: #ccc; }

/* 操作 */
.card-actions { display: flex; align-items: center; gap: 20rpx; }
.action-btn.primary { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 44rpx; color: #fff; font-size: 28rpx; font-weight: 700; border: none; }
.action-btn.primary.quiz-btn { background: linear-gradient(135deg,#7B1FA2,#9C27B0); }
.action-link { font-size: 26rpx; color: #bbb; padding: 8rpx 16rpx; text-align: center; flex: 1; }
.action-link.done-text { color: #4CAF50; font-weight: 600; }
