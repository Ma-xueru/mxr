.te-page { min-height: 100vh; background: #f5f0e8; padding-bottom: 40rpx; }

.te-loading { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.te-loading-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.te-loading-text { font-size: 28rpx; color: #999; }

/* 答题 */
.te-body { padding: 24rpx 30rpx; }
.te-header { text-align: center; margin-bottom: 30rpx; }
.te-course-title { font-size: 36rpx; font-weight: 700; color: #3d3532; display: block; margin-bottom: 16rpx; }
.te-progress-bar { height: 8rpx; background: #e0d8c8; border-radius: 4rpx; overflow: hidden; margin-bottom: 8rpx; }
.te-progress-fill { height: 100%; background: linear-gradient(90deg,#8b9d6f,#a8c080); border-radius: 4rpx; transition: width .3s; }
.te-progress-text { font-size: 26rpx; color: #999; }

.te-card { background: #fffdf7; border-radius: 24rpx; padding: 40rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(80,50,20,.06); }
.te-question { font-size: 34rpx; font-weight: 700; color: #3d3532; line-height: 1.8; margin-bottom: 36rpx; }
.te-options { display: flex; flex-direction: column; gap: 16rpx; }
.te-opt { display: flex; align-items: center; gap: 14rpx; padding: 22rpx 28rpx; border-radius: 16rpx; font-size: 30rpx; border: 2rpx solid #e8e0d0; background: #fdfbf6; color: #4a4030; transition: all .2s; }
.te-opt:active { background: #f0ebe0; transform: scale(.98); }
.te-opt-letter { font-weight: 700; font-size: 32rpx; color: #8b9d6f; min-width: 36rpx; }
.te-opt.correct { background: #2e7d32; border-color: #1b5e20; color: #fff; font-weight: 700; }
.te-opt.correct .te-opt-letter { color: #fff; }
.te-opt.wrong { background: #c62828; border-color: #b71c1c; color: #fff; font-weight: 700; }
.te-opt.wrong .te-opt-letter { color: #fff; }
.te-opt.dimmed { opacity: .35; transform: scale(.97); }

.te-analysis { margin-top: 24rpx; padding: 20rpx 24rpx; background: #fff8e1; border-radius: 14rpx; border-left: 6rpx solid #ffb74d; }
.te-analysis-label { font-size: 24rpx; font-weight: 700; color: #e65100; display: block; margin-bottom: 8rpx; }
.te-analysis-text { font-size: 26rpx; color: #5d4037; line-height: 1.8; }

.te-next { margin-top: 32rpx; }
.te-next-btn { width: 100%; height: 88rpx; line-height: 88rpx; background: linear-gradient(135deg,#8b9d6f,#6d8056); color: #fff; font-size: 30rpx; font-weight: 700; border-radius: 44rpx; border: none; }

/* 结果 */
.te-result-score-wrap { text-align: center; padding: 60rpx 30rpx 40rpx; }
.te-result-emoji { font-size: 72rpx; display: block; margin-bottom: 12rpx; }
.te-result-score { font-size: 120rpx; font-weight: 800; color: #3d3532; display: block; line-height: 1; }
.te-result-label { font-size: 28rpx; color: #999; margin-top: 12rpx; display: block; }

.te-report { margin: 0 30rpx 20rpx; padding: 24rpx; background: #fffdf7; border-radius: 20rpx; }
.te-report-title { font-size: 28rpx; font-weight: 700; color: #3d3532; margin-bottom: 16rpx; }
.te-dim-card { padding: 16rpx 14rpx; margin-bottom: 12rpx; border-radius: 12rpx; background: #fafbfc; }
.te-dim-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.te-dim-name { font-size: 26rpx; font-weight: 700; color: #333; }
.te-dim-score { font-size: 28rpx; font-weight: 800; color: #4CAF50; }
.te-dim-bar { height: 8rpx; background: #eee; border-radius: 4rpx; overflow: hidden; margin-bottom: 8rpx; }
.te-dim-fill { height: 100%; border-radius: 4rpx; }
.te-dim-comment { font-size: 22rpx; color: #555; line-height: 1.6; display: block; }
.te-suggestion { margin-top: 16rpx; padding: 18rpx 20rpx; background: linear-gradient(135deg,#f0fbf1,#e8f5e9); border-radius: 14rpx; border: 1rpx solid #c8e6c9; }
.te-sug-label { font-size: 26rpx; font-weight: 700; color: #2e7d32; display: block; margin-bottom: 8rpx; }
.te-sug-text { font-size: 24rpx; color: #33691e; line-height: 1.8; }
.te-overall { margin-top: 12rpx; padding: 16rpx; background: #f5f6fa; border-radius: 14rpx; }
.te-overall-label { font-size: 24rpx; font-weight: 700; color: #5b503f; display: block; margin-bottom: 6rpx; }
.te-overall-text { font-size: 24rpx; color: #6d6050; line-height: 1.8; }

.te-result-actions { display: flex; gap: 16rpx; margin: 20rpx 30rpx; }
.te-btn { flex: 1; height: 80rpx; line-height: 80rpx; background: linear-gradient(135deg,#8b9d6f,#6d8056); color: #fff; font-size: 28rpx; font-weight: 700; border-radius: 40rpx; border: none; }
.te-btn.outline { background: #f0ede5; color: #6d6050; }

.te-radar-wrap { margin: 0 30rpx 20rpx; padding: 20rpx; background: #fffdf7; border-radius: 20rpx; text-align: center; }
.te-radar-canvas { width: 100%; height: 360rpx; }
