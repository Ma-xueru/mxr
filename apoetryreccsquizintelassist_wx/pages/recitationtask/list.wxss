.task-container { min-height: 100vh; background: #f5f0e8; }

.content { width: calc(100vw - 40rpx); margin: 0 auto; padding: 20rpx 0 160rpx; }

/* 卡片 */
.task-list { display: flex; flex-direction: column; gap: 20rpx; }

.task-card { background: #fff; border-radius: 32rpx; padding: 32rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,.06); position: relative; overflow: hidden; }

/* 顶部行 */
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }

.card-badge { font-size: 22rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx; }
.card-badge.recite { background: #E8F5E9; color: #2E7D32; }
.card-badge.quiz { background: #F3E5F5; color: #7B1FA2; }

.card-status { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; font-weight: 600; }
.card-status.done { color: #4CAF50; }
.card-status.pending { color: #FF9800; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.card-status.done .status-dot { background: #4CAF50; }
.card-status.pending .status-dot { background: #FF9800; }

/* 诗歌标题 */
.card-poem { font-size: 36rpx; font-weight: 800; color: #1a1a1a; margin-bottom: 12rpx; line-height: 1.3; }

/* 学生名 */
.card-info { margin-bottom: 16rpx; }
.card-student { font-size: 24rpx; color: #999; }

/* 元信息三列 */
.card-meta { display: flex; gap: 10rpx; margin-bottom: 24rpx; }
.card-meta-item { flex: 1; text-align: center; padding: 16rpx 8rpx; background: #faf7f0; border-radius: 16rpx; }
.meta-label { font-size: 22rpx; color: #bbb; display: block; margin-bottom: 6rpx; }
.meta-value { font-size: 26rpx; font-weight: 600; color: #555; display: block; }
.meta-value.score.high { color: #4CAF50; font-size: 32rpx; font-weight: 800; }
.meta-value.score.mid { color: #FF9800; }
.meta-value.score.none { color: #ccc; }

/* 操作按钮 */
.card-actions { display: flex; align-items: center; gap: 20rpx; }
.action-btn.primary { flex: 1; height: 80rpx; line-height: 80rpx; background: linear-gradient(135deg,#FF8A72,#FFD36A); color: #fff; font-size: 28rpx; font-weight: 700; border-radius: 44rpx; border: none; }
.action-link { font-size: 26rpx; color: #bbb; padding: 8rpx 16rpx; }

/* 已完成卡片的微妙差异 */
.task-card.done::before { content: ''; position: absolute; top: 0; left: 0; width: 6rpx; height: 100%; background: #4CAF50; border-radius: 3rpx 0 0 3rpx; }
.task-card.pending::before { content: ''; position: absolute; top: 0; left: 0; width: 6rpx; height: 100%; background: #FF9800; border-radius: 3rpx 0 0 3rpx; }

.add-btn { position: fixed; right: 40rpx; bottom: 140rpx; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 50%; background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%); color: #fff; font-size: 40rpx; box-shadow: 0 10rpx 22rpx rgba(88,184,111,.24); border: none; }
