<view class="task-container">
  <view class="content">
    <view class="task-list">
      <view class="task-card {{item.completionstatus==='已完成'?'done':'pending'}}" wx:for="{{goodsListData}}" wx:key="id" wx:for-item="item" bindtap="detailBtn" data-item="{{item}}">
        <!-- 顶部行：类型标签 + 完成状态 -->
        <view class="card-top">
          <view class="card-badge {{item.taskType === 2 ? 'quiz' : 'recite'}}">
            {{item.taskType === 2 ? '测验' : '背诵'}}
          </view>
          <view class="card-status {{item.completionstatus==='已完成'?'done':'pending'}}">
            <view class="status-dot"></view>
            <text>{{item.completionstatus === '已完成' ? '已完成' : '待完成'}}</text>
          </view>
        </view>

        <!-- 古诗名（核心标题） -->
        <view class="card-poem">{{item.coursetitles || '未指定古诗'}}</view>

        <!-- 信息行 -->
        <view class="card-info">
          <text class="card-student">{{item.studentname}}（{{item.studentaccount}}）</text>
        </view>

        <view class="card-meta">
          <view class="card-meta-item">
            <text class="meta-label">音频</text>
            <text class="meta-value">{{item.recitationaudio ? '已上传' : '未上传'}}</text>
          </view>
          <view class="card-meta-item">
            <text class="meta-label">得分</text>
            <text class="meta-value score {{item.kaoshichengji ? (item.kaoshichengji>=10?'high':'mid') : 'none'}}">{{item.kaoshichengji || '待评分'}}</text>
          </view>
          <view class="card-meta-item">
            <text class="meta-label">截止</text>
            <text class="meta-value">{{item.deadline || '长期有效'}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="card-actions">
          <button
            wx:if="{{showUploadButton && item.completionstatus !== '已完成'}}"
            class="action-btn primary"
            data-id="{{item.id}}"
            catchtap="uploadAudioBtn">
            {{item.recitationaudio ? '重新上传' : '🎙️ 上传音频'}}
          </button>
          <text
            wx:if="{{editAuth}}"
            class="action-link"
            data-id="{{item.id}}"
            catchtap="editBtn">修改</text>
        </view>
      </view>
    </view>

    <button class="add-btn" wx:if="{{addAuth}}" bindtap="addTap">＋</button>
  </view>
  <voice-assistant />
</view>
