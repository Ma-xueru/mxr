.content {
  padding: 24rpx;
  background: linear-gradient(180deg, #E9F8FF 0%, #F2FBF1 48%, #FFF8DC 100%);
  min-height: 100vh;
}

.hero-box {
  background: linear-gradient(135deg, #FFF8DC 0%, #E9F8FF 48%, #F2FBF1 100%);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(88, 184, 111, 0.12);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.hero-status {
  margin-top: 16rpx;
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%);
  color: #fff;
  font-size: 24rpx;
}

.detail-box {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(88, 184, 111, 0.1);
}

.detail-item-box {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #D7ECCD;
}

.detail-item-box:last-child {
  border-bottom: none;
}

.detail-item-label {
  width: 160rpx;
  color: #2F8F5B;
  font-size: 28rpx;
}

.detail-item-text {
  flex: 1;
  color: #666;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-item-audio {
  align-items: flex-start;
}

.detail-item-audio audio {
  width: 100%;
  margin-top: 6rpx;
}
