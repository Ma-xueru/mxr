.detail-page { min-height: 100vh; background: #f5f0e8; padding: 0 30rpx 40rpx; }

/* 头部古诗卡片 */
.poem-card { background: linear-gradient(135deg,#1B5E20,#2E7D32,#388E3C); border-radius: 28rpx; padding: 40rpx 32rpx; margin-top: 20rpx; }
.poem-title { font-size: 48rpx; font-weight: 900; color: #fff; letter-spacing: 4rpx; }
.poem-sub { font-size: 24rpx; color: rgba(255,255,255,.75); margin-top: 16rpx; line-height: 1.6; }
.poem-teacher { font-size: 22rpx; color: rgba(255,255,255,.55); margin-top: 10rpx; }

/* 分段标签 */
.section-label { font-size: 28rpx; font-weight: 700; color: #3d3532; margin: 28rpx 0 16rpx; padding-left: 12rpx; border-left: 4rpx solid #4CAF50; }

/* 得分圆环 */
.score-card { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 20rpx; }
.score-ring { width: 200rpx; height: 200rpx; border-radius: 50%; border: 10rpx solid #4CAF50; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg,#E8F5E9,#fff); box-shadow: 0 8rpx 32rpx rgba(76,175,80,.2); }
.score-num { font-size: 72rpx; font-weight: 900; color: #2E7D32; line-height: 1; }
.score-unit { font-size: 28rpx; color: #4CAF50; margin-top: 4rpx; }
.score-desc { font-size: 26rpx; color: #999; margin-top: 16rpx; }

/* 维度卡片 */
.dim-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.dim-item { margin-bottom: 24rpx; }
.dim-item:last-child { margin-bottom: 0; }
.dim-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.dim-name { font-size: 28rpx; font-weight: 700; color: #333; }
.dim-score { font-size: 28rpx; font-weight: 800; color: #4CAF50; }
.dim-bar-bg { height: 10rpx; background: #f0f0f0; border-radius: 5rpx; overflow: hidden; margin-bottom: 10rpx; }
.dim-bar-fill { height: 100%; border-radius: 5rpx; background: linear-gradient(90deg,#66BB6A,#43A047); }
.dim-comment { font-size: 24rpx; color: #888; line-height: 1.6; }
.dim-encourage { font-size: 24rpx; color: #FF9800; margin-top: 6rpx; }

/* 总体评价 */
.overall-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.overall-label { font-size: 26rpx; font-weight: 700; color: #333; margin-bottom: 12rpx; }
.overall-text { font-size: 26rpx; color: #666; line-height: 1.8; }

/* 识别文本 */
.recognize-card { background: #f7f8fa; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; }
.recognize-label { font-size: 24rpx; font-weight: 700; color: #888; margin-bottom: 12rpx; }
.recognize-text { font-size: 26rpx; color: #555; line-height: 1.8; font-style: italic; }

/* 任务信息 */
.info-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 26rpx; color: #999; flex-shrink: 0; width: 140rpx; }
.info-value { font-size: 26rpx; color: #333; flex: 1; text-align: right; line-height: 1.6; }
.info-value.teacher-text { color: #2E7D32; font-style: italic; }

/* 音频播放条 */
.audio-card { margin-top: 16rpx; padding: 20rpx 0; }
.audio-label { font-size: 22rpx; color: #999; margin-bottom: 12rpx; }
/* 完成时间 */
.finish-time { text-align: center; font-size: 22rpx; color: #bbb; margin-top: 30rpx; padding-bottom: 20rpx; }

.bottom-space { height: 120rpx; }
