.update-container {
  width: 100vw;
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  width: calc(100vw - 40rpx);
  margin: 20rpx;
  padding-bottom: 60rpx;
}

.header-card {
  background: linear-gradient(135deg, #fff2d8 0%, #eef7ff 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.header-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.form-box {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
}

.item-box {
  padding: 8rpx 0;
  margin: 0 0 24rpx 0;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f1f1f1;
}

.textarea-box {
  align-items: flex-start;
}

.audio-box {
  align-items: flex-start;
}

.item-label {
  width: 160rpx;
  padding-right: 20rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.down-item-picker,
.item-input {
  width: 100%;
  flex: 1;
}

.down-item-picker-text,
.item-input {
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #666;
}

.item-textarea {
  flex: 1;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  padding-top: 18rpx;
}

.audio-content {
  flex: 1;
  padding: 12rpx 0 18rpx;
}

.audio-upload-btn {
  margin: 0;
  width: 220rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #efb24c 0%, #5fb959 100%);
  color: #fff;
  font-size: 26rpx;
}

.audio-file-name {
  margin-top: 18rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
}

.audio-lock-tip {
  display: inline-flex;
  align-items: center;
  margin-top: 4rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fff3f0;
  color: #d95c45;
  font-size: 24rpx;
}

.audio-player {
  margin-top: 18rpx;
  width: 100%;
}

.btn-box {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.submit-btn {
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d84fa9 0%, #5fb959 100%);
  color: #fff;
  font-size: 30rpx;
}
