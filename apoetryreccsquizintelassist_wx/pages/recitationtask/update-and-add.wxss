.page { width: 100vw; min-height: 100vh; background: #f3f4f6; }
.content { padding: 24rpx; }

.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #333; margin-bottom: 24rpx; padding-left: 12rpx; border-left: 6rpx solid #5fb959; }

/* hero */
.hero { background: linear-gradient(135deg, #eef8e0, #e8f4fd); }
.hero-badge { display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx; background: #5fb959; color: #fff; font-size: 22rpx; margin-bottom: 16rpx; }
.hero-title { font-size: 34rpx; font-weight: 700; color: #222; }
.hero-desc { margin-top: 12rpx; font-size: 26rpx; color: #666; line-height: 1.6; }

/* form */
.f-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.f-label { width: 160rpx; font-size: 26rpx; color: #666; }
.f-input, .picker-val { flex: 1; font-size: 26rpx; color: #333; }
.f-textarea { flex: 1; min-height: 120rpx; font-size: 26rpx; line-height: 1.6; }
.f-value { flex: 1; font-size: 26rpx; color: #333; }

/* record card */
.record-card { text-align: center; }

/* idle */
.state-idle { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 40rpx 0; }
.btn-record { width: 300rpx; height: 100rpx; line-height: 100rpx; background: linear-gradient(135deg, #f0a838, #e5941e); color: #fff; font-size: 32rpx; font-weight: 700; border-radius: 50rpx; border: none; }
.hint { font-size: 24rpx; color: #aaa; }

/* recording */
.state-recording { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 40rpx 0; }
.rec-indicator { display: flex; align-items: center; gap: 16rpx; }
.rec-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #f44336; animation: blink 0.8s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.15} }
.rec-time { font-size: 48rpx; font-weight: 700; color: #333; font-family: monospace; }
.btn-stop { width: 180rpx; height: 68rpx; line-height: 68rpx; background: #f44336; color: #fff; font-size: 28rpx; font-weight: 700; border-radius: 34rpx; border: none; }

/* has audio */
.state-has-audio { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 30rpx 0; }
.player { width: 100%; display: flex; align-items: center; gap: 16rpx; }
.player-btn { width: 72rpx; height: 72rpx; line-height: 72rpx; background: #5fb959; color: #fff; font-size: 28rpx; border-radius: 50%; border: none; text-align: center; }
.player-btn.playing { background: #f0a838; }
.player-bar { flex: 1; height: 10rpx; background: #eee; border-radius: 5rpx; overflow: hidden; }
.player-fill { height: 100%; background: #5fb959; border-radius: 5rpx; }
.player-time { font-size: 22rpx; color: #999; font-family: monospace; min-width: 80rpx; }
.audio-status { font-size: 22rpx; color: #5fb959; font-weight: 600; }
.btn-retry { width: 200rpx; height: 52rpx; line-height: 52rpx; background: #fff; color: #e5941e; font-size: 24rpx; border: 2rpx solid #e8c060; border-radius: 26rpx; }

/* locked */
.lock-text { display: block; text-align: center; color: #999; font-size: 26rpx; padding: 30rpx 0; }

/* submit */
.submit-area { padding: 20rpx 0 60rpx; }
.btn-submit { width: 100%; height: 88rpx; line-height: 88rpx; background: linear-gradient(135deg, #5fb959, #3d8b3d); color: #fff; font-size: 30rpx; font-weight: 700; border-radius: 44rpx; border: none; }
