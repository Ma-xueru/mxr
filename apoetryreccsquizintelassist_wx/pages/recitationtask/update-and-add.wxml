<view class="page">
  <view class="content">
    <!-- 标题区 -->
    <view class="card hero">
      <view class="hero-badge">{{tableName=='teacher' ? '发布任务' : '我的背诵'}}</view>
      <view class="hero-title">{{tableName=='teacher' ? '给学生布置背诵任务' : tasktitle || '背诵任务'}}</view>
      <view class="hero-desc" wx:if="{{tableName=='student'}}">{{taskcontent || '请按老师要求完成背诵'}}</view>
    </view>

    <!-- 教师端表单 -->
    <view class="card form-card" wx:if="{{tableName=='teacher'}}">
      <view class="section-title">任务信息</view>
      <view class="f-item"><view class="f-label">学生账号</view>
        <picker bindchange="studentaccountChange" value="{{studentaccountIndex}}" range="{{studentaccountList}}">
          <view class="picker-val">{{studentaccountList[studentaccountIndex]||'请选择'}}</view>
        </picker>
      </view>
      <view class="f-item"><view class="f-label">学生姓名</view><input class="f-input" value="{{studentname}}" disabled placeholder="自动填入" /></view>
      <view class="f-item"><view class="f-label">任务标题</view><input class="f-input" value="{{tasktitle}}" bindinput="tasktitleInput" placeholder="如：背诵《静夜思》" /></view>
      <view class="f-item"><view class="f-label">任务要求</view><textarea class="f-textarea" value="{{taskcontent}}" bindinput="taskcontentInput" placeholder="描述背诵内容、要求等" /></view>
      <view class="f-item"><view class="f-label">截止日期</view><view class="picker-val" bindtap="ondeadlineTap">{{deadline}}</view></view>
      <com-date isShowPicker="{{showdeadline}}" bind:dateHandler="deadlineTap"></com-date>
    </view>

    <!-- 学生端：录音区 -->
    <view class="card record-card" wx:if="{{tableName=='student' && !audioLocked}}">
      <view class="section-title">我的录音</view>
      <!-- 无录音 -->
      <view class="state-idle" wx:if="{{state=='idle'}}">
        <button class="btn-record" bindtap="startRecord">🎤 开始录音</button>
        <text class="hint">点一下，开始背诵吧</text>
      </view>
      <!-- 录音中 -->
      <view class="state-recording" wx:if="{{state=='recording'}}">
        <view class="rec-indicator"><view class="rec-dot"></view><text class="rec-time">{{recordTimeDisplay}}</text></view>
        <button class="btn-stop" bindtap="stopRecord">停止录音</button>
      </view>
      <!-- 有音频：预览/上传中/已上传 -->
      <view class="state-has-audio" wx:if="{{state=='preview'||state=='uploading'||state=='done'}}">
        <view class="player">
          <view class="player-btn {{isPlaying?'playing':''}}" bindtap="togglePlay">{{isPlaying ? '⏸' : '▶'}}</view>
          <view class="player-bar"><view class="player-fill" style="width:{{playProgress}}%"></view></view>
          <text class="player-time">{{currentTimeDisplay}}</text>
        </view>
        <view class="audio-status">
          <text wx:if="{{state=='uploading'}}">上传中...</text>
          <text wx:elif="{{state=='preview'}}">本地预览 - 满意后点提交</text>
          <text wx:else>已上传 ✓</text>
        </view>
        <button class="btn-retry" bindtap="startRecord">重新录音</button>
      </view>
    </view>

    <!-- 已锁定 -->
    <view class="card record-card" wx:if="{{tableName=='student' && audioLocked}}">
      <view class="section-title">录音状态</view>
      <text class="lock-text">该任务已评分，不能修改录音</text>
    </view>

    <!-- 学生端：任务信息 -->
    <view class="card form-card" wx:if="{{tableName=='student'}}">
      <view class="section-title">任务信息</view>
      <view class="f-item"><view class="f-label">指定古诗</view><text class="f-value">{{coursetitles || '老师暂未指定'}}</text></view>
      <view class="f-item"><view class="f-label">老师</view><text class="f-value">{{teachername}}</text></view>
      <view class="f-item"><view class="f-label">截止日期</view><text class="f-value">{{deadline}}</text></view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area" wx:if="{{tableName=='student' && !audioLocked || tableName=='teacher'}}">
      <button class="btn-submit" bindtap="submit">{{tableName=='teacher' ? '发布任务' : '提交背诵'}}</button>
    </view>
  </view>
</view>
