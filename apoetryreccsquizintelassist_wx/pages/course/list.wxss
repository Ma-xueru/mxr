/* 基础样式 */
.goodsClassify-container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.content {
  padding: 20rpx;
}

/* 搜索框样式 */
.search {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
}

.search-inp-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  padding-left: 10rpx;
}

.searchBtn {
  background-color: #4169e1;
  color: #fff;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

/* 列表样式 */
.goodsList-box {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}

.goods-item {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.goods-img {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮样式 */
.operate-box {
  display: flex;
  justify-content: flex-end;
  margin-top: 15rpx;
}

.edit-box, .delete-box {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
}

.edit-icons {
  color: #4169e1;
  font-size: 28rpx;
}

.del-icons {
  color: #ff4d4f;
  font-size: 28rpx;
}

.edit-text, .del-text {
  font-size: 28rpx;
  margin-left: 5rpx;
}

.edit-text {
  color: #4169e1;
}

.del-text {
  color: #ff4d4f;
}

/* 新增按钮样式 */
.add-btn {
  position: fixed;
  bottom: 30rpx;
  right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #4169e1;
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(65, 105, 225, 0.4);
  line-height: 1;
  padding: 0;
}

.add-btn::after {
  border: none;
}