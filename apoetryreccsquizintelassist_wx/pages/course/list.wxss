.list-container { min-height: 100vh; background: #f5f5f5; padding-bottom: 40rpx; }
.content { padding: 20rpx; }

/* 搜索栏 */
.search-bar { display: flex; align-items: center; margin-bottom: 24rpx; background: #fff; padding: 16rpx 20rpx; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.search-inp-box { flex: 1; display: flex; align-items: center; background: #f5f5f5; border-radius: 16rpx; padding: 0 20rpx; margin-right: 16rpx; }
.search-icon { font-size: 28rpx; color: #999; margin-right: 8rpx; }
.search-input { flex: 1; height: 64rpx; font-size: 28rpx; }
.searchBtn { background: #85c9b6; color: #fff; padding: 0 32rpx; height: 64rpx; line-height: 64rpx; border-radius: 32rpx; font-size: 28rpx; font-weight: 600; }

/* 卡片列表 */
.card-list { display: flex; flex-direction: column; gap: 24rpx; }

/* 诗词卡片 */
.poem-card { margin: 0 10rpx; background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 10rpx 30rpx rgba(0,0,0,.05); }
.poem-card:active { transform: scale(.98); transition: transform .2s; }

/* 中国风渐变图 */
.card-img { width: 100%; height: 260rpx; display: flex; align-items: center; justify-content: center; border-top-left-radius: 20rpx; border-top-right-radius: 20rpx; }
.card-img-title { font-size: 52rpx; color: rgba(255,255,255,.55); font-weight: 800; letter-spacing: 12rpx; }

/* 8套中国风配色 */
.card-bg-0 { background: linear-gradient(135deg, #a8e6cf, #88d8b0, #56ab91); }
.card-bg-1 { background: linear-gradient(135deg, #fbc2eb, #a6c1ee, #84a9d6); }
.card-bg-2 { background: linear-gradient(135deg, #ffecd2, #fcb69f, #e8936b); }
.card-bg-3 { background: linear-gradient(135deg, #a1c4fd, #c2e9fb, #8bb8e8); }
.card-bg-4 { background: linear-gradient(135deg, #d4fc79, #96e6a1, #6abf69); }
.card-bg-5 { background: linear-gradient(135deg, #fddb92, #d1b38d, #ab8e6e); }
.card-bg-6 { background: linear-gradient(135deg, #e0c3fc, #c3aed6, #9b8cbe); }
.card-bg-7 { background: linear-gradient(135deg, #f9d5d3, #e6b0aa, #c9958b); }

/* 信息区 */
.card-info { padding: 24rpx 30rpx; }

/* 标题行 */
.card-title-row { margin-bottom: 16rpx; }
.card-title { font-size: 40rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }

/* 标签行 */
.card-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { display: inline-block; padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; background: rgba(133,201,182,.1); color: #85c9b6; font-weight: 500; }
