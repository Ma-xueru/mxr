.poem-page { min-height: 100vh; background: #fdfbf0; padding-bottom: 60rpx; }

/* 头部 */
.poem-header { text-align: center; padding: 60rpx 40rpx 30rpx; }
.poem-title { font-size: 48rpx; font-weight: 800; color: #333; letter-spacing: 8rpx; }
.poem-meta { font-size: 28rpx; color: #888; margin-top: 16rpx; }

/* 田字格诗句 */
.poem-body { display: flex; flex-direction: column; align-items: center; padding: 20rpx 30rpx; }
.poem-line { display: flex; justify-content: center; margin-bottom: 16rpx; }
.char-unit { display: flex; flex-direction: column; align-items: center; margin: 0 6rpx; }
.char-pinyin { 
  font-size: 22rpx; color: #555; height: 34rpx; line-height: 34rpx;
  text-align: center; white-space: nowrap;
}
.char-grid {
  width: 80rpx; height: 80rpx;
  border: 1rpx solid #dcdcdc;
  background-image:
    linear-gradient(to bottom, transparent 49%, #eee 50%, transparent 51%),
    linear-gradient(to right, transparent 49%, #eee 50%, transparent 51%);
  display: flex; align-items: center; justify-content: center;
}
.char-hanzi { font-size: 44rpx; color: #333; line-height: 1; }

/* AI跟读入口 */
.poem-follow { margin: 20rpx 30rpx; }
.fr-card { display: flex; align-items: center; padding: 24rpx 20rpx; background: linear-gradient(135deg,#E8F5E9,#C8E6C9); border-radius: 20rpx; border: 2rpx solid rgba(76,175,80,.2); }
.fr-card:active { transform: scale(.98); }
.fr-icon { font-size: 48rpx; margin-right: 16rpx; }
.fr-info { flex: 1; }
.fr-title { font-size: 30rpx; font-weight: 700; color: #2E7D32; display: block; }
.fr-desc { font-size: 24rpx; color: #6B8B6F; margin-top: 4rpx; display: block; }
.fr-arrow { font-size: 32rpx; color: #4CAF50; font-weight: 700; }
.fr-last { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 20rpx; margin-top: 12rpx; background: #FFF8E1; border-radius: 14rpx; }
.fr-last-label { font-size: 22rpx; color: #8B8B6F; }
.fr-last-score { font-size: 30rpx; font-weight: 800; color: #F57C00; }
.fr-last-time { font-size: 20rpx; color: #aaa; margin-left: auto; }

/* 折叠区域 */
.poem-section { margin: 8rpx 30rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 20rpx; }
.section-header:active { opacity: .7; }
.section-title { font-size: 30rpx; font-weight: 700; color: #555; }
.section-arrow { font-size: 28rpx; color: #aaa; }
.section-body { padding: 0 20rpx 16rpx; }
.section-block { background: #f0eee5; border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; font-size: 26rpx; color: #555; line-height: 1.8; }
