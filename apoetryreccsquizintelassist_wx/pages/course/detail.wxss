.poem-page { min-height: 100vh; background: #fdfbf0; padding-bottom: 60rpx; }

.poem-header { text-align: center; padding: 60rpx 40rpx 30rpx; }
.poem-title { font-size: 48rpx; font-weight: 800; color: #333; letter-spacing: 8rpx; }
.poem-meta { font-size: 28rpx; color: #888; margin-top: 16rpx; }

/* 古诗意境图 — 3:2黄金比例 + 边缘羽化 */
.poem-image-section { margin: 0 30rpx 24rpx; }
.poem-image {
  width: 100%; aspect-ratio: 3 / 2; border-radius: 16rpx; display: block;
  box-shadow: 0 10rpx 30rpx rgba(60,40,20,.05);
  mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, rgba(0,0,0,1) 70%, rgba(0,0,0,.7) 85%, rgba(0,0,0,0) 100%);
  -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, rgba(0,0,0,1) 70%, rgba(0,0,0,.7) 85%, rgba(0,0,0,0) 100%);
}
.poem-image-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; aspect-ratio: 3 / 2; background: linear-gradient(135deg,#f5f5f0,#e8e4d8); border-radius: 16rpx; }
.poem-image-loading-icon { font-size: 80rpx; animation: float 2s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
.poem-image-loading-text { font-size: 26rpx; color: #8B8B6F; margin-top: 16rpx; }
.poem-image-error { padding: 40rpx; text-align: center; background: #fef5f5; border-radius: 16rpx; }
.poem-image-error-text { font-size: 24rpx; color: #999; }

/* 田字格诗句 */
.poem-body { display: flex; flex-direction: column; align-items: center; padding: 20rpx 30rpx; }
.poem-line { display: flex; justify-content: center; margin-bottom: 12rpx; gap: 6rpx; }

/* 田字格 — 拼音+汉字共居一格的父容器 */
.hanzi-grid {
  width: 100rpx; height: 110rpx;
  border: 1rpx solid #dcdcdc;
  background-image:
    linear-gradient(to bottom, transparent 49%, #e8e8e8 50%, transparent 51%),
    linear-gradient(to right, transparent 49%, #e8e8e8 50%, transparent 51%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.grid-pinyin {
  font-size: 24rpx;
  color: #555;
  line-height: 1;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-top: 6rpx;
}

.grid-char {
  font-size: 44rpx;
  color: #333;
  line-height: 1;
  text-align: center;
  padding-bottom: 6rpx;
}

/* AI跟读区域 — 正文下方 */
.follow-section { margin: 28rpx 30rpx 20rpx; }
.follow-main-card { display: flex; align-items: center; padding: 28rpx 24rpx; background: linear-gradient(135deg,#E8F5E9,#C8E6C9); border-radius: 20rpx; border: 2rpx solid rgba(76,175,80,.2); }
.follow-main-card:active { transform: scale(.98); }
.follow-card-left { margin-right: 16rpx; }
.follow-card-icon { font-size: 52rpx; }
.follow-card-center { flex: 1; }
.follow-card-title { font-size: 32rpx; font-weight: 800; color: #2E7D32; display: block; }
.follow-card-desc { font-size: 24rpx; color: #6B8B6F; margin-top: 4rpx; display: block; }
.follow-card-right { flex-shrink: 0; }
.follow-card-btn { font-size: 26rpx; color: #fff; background: linear-gradient(135deg,#4CAF50,#388E3C); padding: 12rpx 24rpx; border-radius: 30rpx; font-weight: 700; display: block; }

/* 历史成绩 */
.follow-history { margin-top: 20rpx; }
.follow-history-title { font-size: 28rpx; font-weight: 700; color: #555; margin-bottom: 12rpx; padding-left: 4rpx; }
.follow-history-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: #fff; border-radius: 14rpx; margin-bottom: 10rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.follow-history-item:active { background: #f8f8f8; }
.fhi-score { font-size: 36rpx; font-weight: 800; min-width: 80rpx; text-align: center; }
.fhi-score.score-high { color: #4CAF50; }
.fhi-score.score-mid { color: #FF9800; }
.fhi-score.score-low { color: #F44336; }
.fhi-bars { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.fhi-dim { display: flex; align-items: center; gap: 8rpx; }
.fhi-dim-name { font-size: 20rpx; color: #888; min-width: 100rpx; }
.fhi-dim-bar { flex: 1; height: 8rpx; background: #eee; border-radius: 4rpx; overflow: hidden; }
.fhi-dim-fill { height: 100%; border-radius: 4rpx; }
.fhi-time { font-size: 20rpx; color: #bbb; min-width: 120rpx; text-align: right; }

/* 折叠区域 */
.poem-section { margin: 8rpx 30rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 20rpx; }
.section-header:active { opacity: .7; }
.section-title { font-size: 30rpx; font-weight: 700; color: #555; }
.section-arrow { font-size: 28rpx; color: #aaa; }
.section-body { padding: 0 20rpx 16rpx; }
.section-block { background: #f0eee5; border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; font-size: 26rpx; color: #555; line-height: 1.8; }

/* 跟读报告弹窗 */
.fr-report-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.7); z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}
.fr-report-modal {
  position: relative; width: 640rpx; max-height: 80vh;
  background: #fefefe; border-radius: 32rpx;
  overflow: hidden; display: flex; flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.2);
}
.fr-report-close {
  position: absolute; top: 16rpx; right: 16rpx; z-index: 10;
  width: 60rpx; height: 60rpx; line-height: 60rpx;
  text-align: center; font-size: 32rpx; color: rgba(255,255,255,.8);
  background: rgba(0,0,0,.15); border-radius: 50%;
}
.fr-report-head {
  text-align: center; padding: 40rpx 0 24rpx;
  background: linear-gradient(135deg,#E8F5E9,#C8E6C9);
  flex-shrink: 0;
}
.fr-big-score { font-size: 100rpx; font-weight: 800; color: #2E7D32; display: block; line-height: 1; }
.fr-big-label { font-size: 26rpx; color: #666; margin-top: 8rpx; display: block; }
.fr-report-scroll { padding: 20rpx 28rpx 8rpx; max-height: 52vh; }
.fr-dim-card { padding: 18rpx 14rpx; margin-bottom: 14rpx; border-radius: 14rpx; background: #fafbfc; border: 1rpx solid #eee; }
.fr-dim-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.fr-dim-name { font-size: 26rpx; font-weight: 700; color: #333; }
.fr-dim-weight { font-size: 20rpx; color: #aaa; }
.fr-dim-score { margin-left: auto; font-size: 28rpx; font-weight: 800; color: #4CAF50; }
.fr-dim-bar { height: 10rpx; background: #eee; border-radius: 5rpx; overflow: hidden; margin-bottom: 10rpx; }
.fr-dim-fill { height: 100%; border-radius: 5rpx; transition: width .6s ease; }
.fr-dim-comment { font-size: 22rpx; color: #555; line-height: 1.6; display: block; margin-bottom: 4rpx; }
.fr-dim-encourage { font-size: 22rpx; color: #FF9800; font-weight: 600; display: block; }
.fr-overall { margin-top: 12rpx; padding: 16rpx; background: #FFF8E1; border-radius: 14rpx; }
.fr-overall-label { font-size: 24rpx; font-weight: 700; color: #F57C00; display: block; margin-bottom: 6rpx; }
.fr-overall-text { font-size: 24rpx; color: #555; line-height: 1.6; }
/* AI测验 */
.quiz-entry { margin-top: 16rpx; }
.quiz-btn { background: linear-gradient(135deg,#8b9d6f,#6d8056) !important; }
.quiz-history-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: #fff; border-radius: 14rpx; margin-bottom: 10rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.quiz-hi-info { flex: 1; }
.quiz-hi-detail { font-size: 24rpx; color: #888; }

/* 引导按钮 */
.guide-btn-box { margin-top: 20rpx; padding: 20rpx; text-align: center; background: linear-gradient(135deg,#e8f5e9,#f1f8e9); border-radius: 14rpx; }
.guide-btn-box:active { opacity: .7; }
.guide-btn-text { font-size: 26rpx; color: #2e7d32; font-weight: 600; }

.fr-close-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #4CAF50; color: #fff; font-size: 28rpx; font-weight: 700;
  border: none; flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom, 0);
}
