<view class="list-container">
  <view class="content">
    <view class="search-bar">
      <view class="search-inp-box">
        <text class="iconfont icon-sousuo1 search-icon"></text>
        <input class="search-input" model:value="{{name}}" type="text" placeholder="搜索古诗..." />
      </view>
      <view class="searchBtn" bind:tap="search">搜索</view>
    </view>

    <view class="card-list">
      <view class="poem-card" bindtap="detailBtn" data-item="{{item}}" data-id="{{item.id}}" wx:for="{{goodsListData}}" wx:key="id">
        <view class="card-img-wrap">
          <image class="card-img" wx:if="{{poemImages[item.id]}}" src="{{poemImages[item.id]}}" mode="aspectFill" lazy-load="true" />
          <view class="card-img-warm" wx:if="{{poemImages[item.id]}}"></view>
          <view class="card-cover" wx:else>
          <view class="cover-border">
            <text class="cover-title">{{item.coursetitle}}</text>
            </view>
          </view>
        </view>
        <view class="card-info">
          <view class="card-title-row">
            <text class="card-title">{{item.coursetitle}}</text>
          </view>
          <view class="card-tags">
            <text class="tag" wx:if="{{item.authorName || item.author_name}}">{{item.authorName || item.author_name}}</text>
            <text class="tag" wx:if="{{item.grade}}">{{item.grade}}</text>
            <text class="tag" wx:if="{{item.coursetype}}">{{item.coursetype}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

<voice-assistant />
</view>
