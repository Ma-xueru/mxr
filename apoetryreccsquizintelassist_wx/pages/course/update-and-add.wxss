/* 表单页面样式 */
.form-container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

/* 表单项样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.form-input-box {
  width: 100%;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea-box {
  width: 100%;
}

.form-textarea {
  width: 100%;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 上传区域样式 */
.form-upload-box {
  width: 100%;
}

.upload-btn {
  width: 100%;
  height: 120rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  padding: 0;
}

.upload-btn::after {
  border: none;
}

.upload-preview {
  width: 100%;
  height: 300rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
}

/* 按钮区域 */
.btn-section {
  padding: 0 30rpx;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #58B86F 0%, #56BDE8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 90rpx;
  border-radius: 45rpx;
  padding: 0;
  margin-bottom: 30rpx;
}

.save-btn::after {
  border: none;
}
