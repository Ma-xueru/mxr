
<view class="update-container">
 <view class="content">
     <view class="form-box">
    <view class="item-box">
        <view class="item-label">用户账号</view>
        <input  class="item-input"
type="text"  disabled="{{ro.studentaccount==true}}"  placeholder="用户账号" model:value="{{studentaccount}}" />
    </view>
    <view class="item-box">
        <view class="item-label">用户密码</view>
        <input  class="item-input"
type="text"  disabled="{{ro.studentpassword==true}}"  placeholder="用户密码" model:value="{{studentpassword}}" />
    </view>
    <view class="item-box">
        <view class="item-label">用户姓名</view>
        <input  class="item-input"
type="text"  disabled="{{ro.studentname==true}}"  placeholder="用户姓名" model:value="{{studentname}}" />
    </view>
<view class="item-box"    bindtap="uploadavatar">
    <view   class="item-label">头像</view>
    <image  src="{{avatarPath?avatarPath:imgIcon}}" mode="aspectFill"  class="item-img"></image>
</view>
<view class="item-box">
<view class="item-label" >性别</view>
<picker   class="down-item-picker"     bindchange="genderChange" value="{{genderIndex}}"  range="{{genderList}}">
    <view class="down-item-picker-text">
        {{genderIndex||genderIndex==0?genderList[genderIndex]:"请选择性别"}}
    </view>
</picker>
</view>
    <view class="item-box">
        <view class="item-label">手机号码</view>
        <input  class="item-input"
type="text"  disabled="{{ro.telephone==true}}"  placeholder="手机号码" model:value="{{telephone}}" />
    </view>

 <view class="item-box">
     <view class="item-label">性别</view>
     <input  class="item-input" type="text"  disabled="{{ro.gender==true}}"  placeholder="性别" model:value="{{gender}}" />
 </view>


     </view>


     <view class="btn-box">



  <button     class="submit-btn" bindtap="submit">提交</button>
     </view>


    </view>

</view>