<view class="register-container">
  <!-- 装饰元素 -->
  <view class="decorative-element top-left"></view>
  <view class="decorative-element bottom-right"></view>
  
  <!-- 顶部装饰条 -->
  <view class="top-decoration"></view>
  
  <view class="content">
    <!-- 页面标题 -->
    <view class="page-title">
      <text>用户注册</text>
    </view>
    
    <!-- 头像上传区域 -->
    <view class="avatar-box">
      <image class="upload-img" bindtap="avatarTap" src="{{tempPathavatar}}" mode="aspectFill"></image>
      <text class="upload-text">点击上传头像</text>
    </view>
    
    <!-- 表单内容 -->
    <view class="box">
      <input type="text" placeholder="用户账号" model:value="{{studentaccount}}" />
    </view>
    <view class="box">
      <input type="password" placeholder="请输入用户密码" model:value="{{studentpassword}}" />
    </view>
    <view class="box">
      <input type="password" placeholder="请确认用户密码" model:value="{{studentpassword2}}"/>
    </view>
    <view class="box">
      <input type="text" placeholder="用户姓名" model:value="{{studentname}}" />
    </view>
    <view class="item-box">
      <picker mode="selector" range="{{genderList}}" value="{{genderIndex}}" bindchange="genderChange">
        <view class="select-date">
          <text class="picker-text">{{genderList[genderIndex] || '请选择性别'}}</text>
        </view>
      </picker>
    </view>
    <view class="box">
      <input type="text" placeholder="手机号码" model:value="{{telephone}}" />
    </view>
 
    
    <button class="register-btn" bindtap="register">注册</button>
  </view>
</view>
    