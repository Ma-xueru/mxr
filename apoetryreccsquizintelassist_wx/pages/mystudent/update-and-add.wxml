
<view class="update-container">
 <view class="content">
     <view class="form-box">
    <view class="item-box">
        <view class="item-label">用户账号</view>
        <input  class="item-input"
type="text"  disabled="{{ro.studentaccount==true}}"  placeholder="用户账号" model:value="{{studentaccount}}" />
    </view>
    <view class="item-box">
        <view class="item-label">用户姓名</view>
        <input  class="item-input"
type="text"  disabled="{{ro.studentname==true}}"  placeholder="用户姓名" model:value="{{studentname}}" />
    </view>
    <!-- 无   teacheraccount 下2  -->
<view class="item-box">
    <view class="item-label" >教师账号</view>
    <picker   class="down-item-picker"     bindchange="teacheraccountChange" value="{{teacheraccountIndex}}"  range="{{teacheraccountList}}">
                <view class="down-item-picker-text">
                    {{teacheraccountIndex||teacheraccountIndex==0?teacheraccountList[teacheraccountIndex]:"请选择教师账号"}}
                </view>
    </picker>
</view>
    <view class="item-box">
        <!-- 随 -->

        <view class="item-label">教师姓名</view>
        <input  class="item-input" type="text"   placeholder="教师姓名" model:value="{{teachername}}" />
    </view>



     </view>


     <view class="btn-box">



  <button     class="submit-btn" bindtap="submit">提交</button>
     </view>


    </view>

</view>