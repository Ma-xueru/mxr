/* 全局样式变量定义 */
page {
  --primary-color: #58B86F; /* 儿童乡村清新主题 */
  --primary-light: #EAF8DF;
  --primary-dark: #2F8F5B;
  --primary-gradient: linear-gradient(135deg, #58B86F, #56BDE8);
  --text-primary: #333333;
  --text-secondary: #666666;
  --border-color: #D7ECCD;
  --white: #ffffff;
  --shadow: 0 10rpx 26rpx rgba(88, 184, 111, 0.14);
  --card-shadow: 0 6rpx 18rpx rgba(88, 184, 111, 0.12);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 顶部装饰条 */
.top-decoration {
  height: 12rpx;
  width: 100%;
  background: var(--primary-gradient);
}

/* 页面标题 */
.page-title {
  padding: 30rpx 30rpx 15rpx;
  text-align: center;
}

.title-text {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 600;
  position: relative;
  padding: 0 30rpx;
}

.title-underline {
  width: 80rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
  margin: 15rpx auto 0;
  opacity: 0.7;
}

.update-container {
  width: 100vw;
  background: linear-gradient(180deg, #E9F8FF 0%, #F2FBF1 100%);
  min-height: 100vh;
}

.content {
  width: calc(100vw - 60rpx);
  margin: 30rpx;
  padding: 30rpx;
  background-color: var(--white);
  border-radius: 20rpx;
  box-shadow: var(--card-shadow);
  height: auto;
}

.form-box {
  box-sizing: border-box;
  width: 100%;
}

.item-box {
  padding: 10rpx 0;
  margin: 0 0 30rpx 0;
  border-color: var(--border-color);
  align-items: center;
  border-width: 0 0 2rpx 0;
  background: none;
  display: flex;
  width: 100%;
  border-style: solid;
  height: auto;
  transition: var(--transition);
}

.item-box:last-child {
  margin-bottom: 0;
}

.item-box:focus-within {
  border-color: var(--primary-color);
}

.item-label {
  width: 180rpx;
  padding: 0 20rpx 0 0;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
  text-align: right;
  flex-shrink: 0;
}

.item-text {
  padding: 0 24rpx;
  margin: 0;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
}

.item-img {
  width: 80rpx;
  border-radius: 100%;
  object-fit: cover;
  display: block;
  height: 80rpx;
  border: 2rpx solid var(--primary-light);
}

.down-item-picker {
  width: 100%;
  flex: 1;
  height: auto;
  position: relative;
}

.down-item-picker::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  border-bottom: 3rpx solid var(--primary-color);
  border-right: 3rpx solid var(--primary-color);
  transform: rotate(45deg) translateY(-50%);
}

.down-item-picker-text {
  width: 100%;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 0 24rpx;
}

.item-input {
  border: 2rpx solid transparent;
  padding: 0 24rpx;
  margin: 0;
  color: var(--text-primary);
  border-radius: 10rpx;
  flex: 1;
  background-color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  transition: var(--transition);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.item-input:focus {
  border-color: var(--primary-color);
  background-color: var(--white);
  box-shadow: 0 0 0 4rpx rgba(88, 184, 111, 0.14);
}

.item-input:disabled {
  background-color: #f5f7fa;
  color: var(--text-secondary);
  opacity: 0.8;
}

.item-radio-itemBox {
  align-items: center;
  display: flex;
  flex: 1;
  padding: 0 24rpx;
}

.item-radio-item {
  align-items: center;
  margin: 0 20rpx 0 0;
  display: flex;
}

.item-checkbox-itemBox {
  align-items: center;
  display: flex;
  flex: 1;
  padding: 0 24rpx;
  flex-wrap: wrap;
}

.radio-itemText {
  color: var(--text-secondary);
  margin-left: 10rpx;
}

.item-checkbox-item {
  align-items: center;
  margin: 0 20rpx 15rpx 0;
  display: flex;
}

.active {
  color: var(--primary-color);
}

checkbox .wx-checkbox-input {
  border: 2rpx solid var(--primary-color);
  border-radius: 50%;
  background: var(--white);
  width: 32rpx;
  height: 32rpx;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  border: 2rpx solid var(--primary-color);
  color: var(--white);
  background: var(--primary-color);
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 20rpx;
  transform: translate(-50%, -50%) scale(1);
}

radio .wx-radio-input {
  border: 2rpx solid var(--primary-color);
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
}

radio .wx-radio-input.wx-radio-input-checked {
  border-color: var(--primary-color);
  background-color: var(--white);
}

radio .wx-radio-input.wx-radio-input-checked::before {
  background-color: var(--primary-color);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%) scale(1);
}

.btn-box {
  width: 100%;
  justify-content: center;
  display: flex;
  height: auto;
  margin-top: 50rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--border-color);
}

.submit-btn {
  border: 0;
  padding: 0;
  margin: 0 20rpx;
  color: var(--white);
  border-radius: 60rpx;
  background: var(--primary-color);
  width: 40%;
  line-height: 90rpx;
  font-size: 30rpx;
  height: 90rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 14rpx rgba(88, 184, 111, 0.2);
  transition: var(--transition);
  text-align: center;
}

.submit-btn:active {
  background: var(--primary-dark);
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(88, 184, 111, 0.2);
}

.face-btn {
  border: 2rpx solid var(--primary-color);
  padding: 0;
  margin: 0 20rpx;
  color: var(--primary-color);
  border-radius: 60rpx;
  background: var(--white);
  width: 40%;
  line-height: 86rpx;
  font-size: 30rpx;
  height: 90rpx;
  font-weight: 500;
  transition: var(--transition);
  text-align: center;
}

.face-btn:active {
  background: var(--primary-light);
  transform: scale(0.98);
}

/* 表单分隔线 */
.form-divider {
  width: 100%;
  height: 20rpx;
  position: relative;
  margin: 30rpx 0;
}

.form-divider::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background-color: var(--border-color);
}

/* 表单装饰元素 */
.form-decoration {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--white);
  padding: 0 20rpx;
  color: var(--primary-color);
  font-size: 24rpx;
}
