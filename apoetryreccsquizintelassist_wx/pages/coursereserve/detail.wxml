<view class="detail-container">
    <!-- 装饰元素 -->
    <view class="decorative-element top-left"></view>
    <view class="decorative-element bottom-right"></view>
    
    <!-- 顶部装饰条 -->
    <view class="top-decoration"></view>
    
    <!-- 页面标题 -->
    <view class="page-title">
        <text>预约详情</text>
    </view>
    
    <view class="content" bind:tap="authTap">
        <view class="detail-box">
            <view class="detail-item-box">
                <view class="detail-item-label">用户账号：</view>
                <view class="detail-item-text">{{detailList.studentaccount}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">用户姓名：</view>
                <view class="detail-item-text">{{detailList.studentname}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">预约时间：</view>
                <view class="detail-item-text">{{detailList.addtime}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">教师账号：</view>
                <view class="detail-item-text">{{detailList.teacheraccount}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">教师姓名：</view>
                <view class="detail-item-text">{{detailList.teachername}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">预约状态：</view>
                <view class="detail-item-text">
                    <view wx:if="{{detailList.reservestatus === '已预约'}}" class="status-passed">{{detailList.reservestatus}}</view>
                    <view wx:if="{{detailList.reservestatus === '已取消'}}" class="status-rejected">{{detailList.reservestatus}}</view>
                    <view wx:if="{{detailList.reservestatus === '待确认'}}" class="status-pending">{{detailList.reservestatus}}</view>
                    <view wx:if="{{detailList.reservestatus !== '已预约' && detailList.reservestatus !== '已取消' && detailList.reservestatus !== '待确认'}}">{{detailList.reservestatus}}</view>
                </view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">人数：</view>
                <view class="detail-item-text">{{detailList.reservecount}}</view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">审核状态：</view>
                <view class="detail-item-text">
                    <view wx:if="{{detailList.sfsh === '是'}}" class="status-passed">通过</view>
                    <view wx:if="{{detailList.sfsh === '否'}}" class="status-rejected">不通过</view>
                    <view wx:if="{{detailList.sfsh === '待审核'}}" class="status-pending">待审核</view>
                </view>
            </view>
            
            <view class="detail-item-box">
                <view class="detail-item-label">回复内容：</view>
                <view class="detail-item-text">
                    <view class="reply-content">{{detailList.shhf || '无回复内容'}}</view>
                </view>
            </view>
        </view>
        
        <view class="operate-box">
            <button class="common-btn cancel-btn" wx:if="{{reservecancelShow}}"
                data-info="reservecancel,'否','reservestatus','已取消',reservestatusCrossSelect[0]" bind:tap="onAcrossTap">
                取消预约
            </button>
            <button class="common-btn cancel-btn" wx:if="{{isAuthreservecancelShow}}"
                data-info="reservecancel,'否','reservestatus','已取消',reservestatusCrossSelect[0]" bind:tap="onAcrossTap">
                取消预约
            </button>
        </view>
    </view>
</view>
    